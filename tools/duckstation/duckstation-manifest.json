      "QtPlugins/platforms/qwindows.dll",
      "resources/duckstation-qt.rcc",
      "LICENSE.txt"
    ],
    "required_executable_markers": [
      "qXportLockstepAttach",
      "qXportLockstepPreludeStart",
      "qXportLockstepStartAt",
      "qXportLockstepHandoffState",
      "qXportLockstepMode",
      "qXportLockstepRecordRead",
      "qXportFunctionCoverageStart",
      "qXportFunctionCoverageRead",
      "qXportLockstepCheckpointCapture",
      "qXportLockstepCheckpointExport",
      "qXportLockstepCheckpointImport",
      "qXportLockstepCheckpointRestore",
      "qXportLockstepLastInstruction",
      "XPORT_DUCKSTATION_DATA_ROOT"
    ],
    "lockstep_protocol_version": 23,
    "lockstep_record_version": 1
  }
