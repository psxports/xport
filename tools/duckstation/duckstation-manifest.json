  },
  "dependencies": {
    "windows-x64": {
      "version": "release-20260805",
      "url": "https://github.com/duckstation/dependencies/releases/download/release-20260805/deps-windows-x64.7z",
      "archive": "deps-windows-x64.7z",
      "sha256": "e1c4dcb10b579f6271d0e39e5055ca17f3de8d93e3f3cd589a4ab14a72fa6e52"
    }
  },
  "build": {
    "solution": "duckstation.sln",
    "target": "duckstation-qt",
    "configuration": "Release",
    "platform": "x64",
    "toolset": "v143",
    "max_cpu_count": 1,
    "source_executable": "bin/x64/duckstation-qt-x64-Release-MSVC.exe",
    "distribution_executable": "duckstation-qt-x64-ReleaseLTCG.exe"
  },
  "runtime": {
    "device_serializer_version": 85,
    "data_root_environment": "XPORT_DUCKSTATION_DATA_ROOT",
