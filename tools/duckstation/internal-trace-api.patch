+// Bounded asynchronous writer for local diagnostic records
+#pragma once
+#include <atomic>
+#include <condition_variable>
+#include <cstdio>
+#include <deque>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+class FFTraceWriter
+{
+public:
+  ~FFTraceWriter() { Finish(); }
+
+  bool Start(FILE* file, size_t capacity = 64 * 1024 * 1024)
+  {
+    if (m_thread.joinable() || !file)
+      return false;
+    m_file = file;
+    m_capacity = capacity;
+    m_pending = m_peak = 0;
+    m_failed = false;
+    m_closing = false;
+    m_thread = std::thread([this] { Run(); });
+    return true;
+  }
+
+  bool Write(std::vector<unsigned char> data)
+  {
+    std::lock_guard lock(m_mutex);
+    if (m_closing || m_failed || data.size() > m_capacity - m_pending)
+    {
+      m_failed = true;
+      return false;
+    }
+    m_pending += data.size();
+    if (m_peak < m_pending)
+      m_peak = m_pending;
+    m_queue.push_back(std::move(data));
+    m_ready.notify_one();
+    return true;
+  }
+
+  bool Finish()
+  {
+    if (!m_thread.joinable())
+      return !m_failed;
+    {
+      std::lock_guard lock(m_mutex);
+      m_closing = true;
+    }
+    m_ready.notify_one();
+    m_thread.join();
+    if (std::fclose(m_file) != 0)
+      m_failed = true;
+    m_file = nullptr;
+    return !m_failed;
+  }
+
+  size_t Peak() const { return m_peak; }
+
+private:
+  void Run()
+  {
+    for (;;)
+    {
+      std::vector<unsigned char> data;
+      {
+        std::unique_lock lock(m_mutex);
+        m_ready.wait(lock, [this] { return m_closing || !m_queue.empty(); });
+        if (m_queue.empty())
+          return;
+        data = std::move(m_queue.front());
+        m_queue.pop_front();
+      }
+      if (!m_failed && std::fwrite(data.data(), 1, data.size(), m_file) != data.size())
+        m_failed = true;
+      {
+        std::lock_guard lock(m_mutex);
+        m_pending -= data.size();
+      }
+    }
+  }
+
+  FILE* m_file = nullptr;
+  std::thread m_thread;
+  std::mutex m_mutex;
+  std::condition_variable m_ready;
+  std::deque<std::vector<unsigned char>> m_queue;
+  std::atomic<bool> m_failed{false};
+  bool m_closing = false;
+  size_t m_capacity = 0, m_pending = 0, m_peak = 0;
+};
