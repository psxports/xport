+bool GDBServer::Cmd$qFFTestPad(ClientSocket* client, std::string_view data)
+{
+  if (!System::IsPaused() || System::IsExecuting())
+  {
+    client->SendReplyWithAck("E20");
+    return true;
+  }
+  auto bytes = StringUtil::DecodeHex(data);
+  if (!bytes || bytes->size() != 8 || FFTrace::Word(bytes->data()) > 1 || FFTrace::Word(bytes->data() + 4) > 65535)
+  {
+    client->SendReplyWithAck("E21");
+    return true;
+  }
+  Controller* controller = Pad::GetController(FFTrace::Word(bytes->data()));
+  if (!controller || controller->GetType() != ControllerType::DigitalController)
+  {
+    client->SendReplyWithAck("E24");
+    return true;
+  }
+  const u32 mask = FFTrace::Word(bytes->data() + 4);
+  for (u32 bit = 0; bit < 16; bit++)
+    controller->SetBindState(bit, (mask & (1u << bit)) ? 1.0f : 0.0f);
+  client->SendReplyWithAck("OK");
+  return true;
+}
