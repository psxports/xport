+                                                    CPU::g_state.current_instruction_pc,
+                                                    CPU::g_state.current_instruction.bits));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepCheckpointCapture(ClientSocket* client, std::string_view data)
+{
+  const auto frame = StringUtil::FromChars<u32>(data, 16);
+  if (!frame.has_value() || *frame == UINT32_MAX || !System::IsPaused() || System::IsExecuting() ||
+      !s_locals.lockstep_peer.IsAttached() || !s_locals.lockstep_replay_active ||
+      !s_locals.lockstep_frame_active ||
+      s_locals.lockstep_event_pending || s_locals.lockstep_transition_pending ||
+      s_locals.lockstep_frame != *frame + 1u)
+    return SendLockstepError(client, "checkpoint", "capture_not_ready");
+
+  std::vector<u8>& candidate = s_locals.lockstep_checkpoint_candidate;
+  const std::vector<u32> wait_state = TimingEvents::CaptureWaitState();
+  const size_t capacity = System::GetMaxSaveStateSize(g_bus.ram_size > Bus::RAM_2MB_SIZE);
+  const u32 wait_bytes = static_cast<u32>(wait_state.size() * sizeof(u32));
+  candidate.resize(8 + capacity + wait_bytes);
+  size_t size = 0;
+  Error error;
+  if (!System::SaveStateDataToBuffer(std::span<u8>(candidate.data() + 8, capacity), &size, &error) ||
+      !size || size > capacity)
+    return SendLockstepError(client, "checkpoint", "capture_failed");
+  const u32 state_bytes = static_cast<u32>(size);
+  std::memcpy(candidate.data(), &state_bytes, sizeof(state_bytes));
+  std::memcpy(candidate.data() + 4, &wait_bytes, sizeof(wait_bytes));
+  std::memcpy(candidate.data() + 8 + size, wait_state.data(), wait_bytes);
+  size += 8 + wait_bytes;
+  candidate.swap(s_locals.lockstep_checkpoint_state);
+  s_locals.lockstep_checkpoint_size = size;
+  s_locals.lockstep_checkpoint_frame = *frame;
+  client->SendReplyWithAck(TinyString::from_format("OK:{:x}:{:x}", *frame, size));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepCheckpointExport(ClientSocket* client, std::string_view data)
+{
+  const auto frame = StringUtil::FromChars<u32>(data, 16);
+  const char* path = std::getenv("XPORT_LOCKSTEP_CHECKPOINT_FILE");
+  if (!frame.has_value() || !System::IsPaused() || System::IsExecuting() ||
+      !s_locals.lockstep_replay_active || !s_locals.lockstep_peer.IsAttached() ||
+      !s_locals.lockstep_checkpoint_size || s_locals.lockstep_checkpoint_frame != *frame ||
+      !path || !*path)
+    return SendLockstepError(client, "checkpoint", "export_not_ready");
+  Error error;
+  if (!FileSystem::WriteAtomicRenamedFile(
+        path, s_locals.lockstep_checkpoint_state.data(), s_locals.lockstep_checkpoint_size, &error))
+    return SendLockstepError(client, "checkpoint", "export_failed");
+  client->SendReplyWithAck(TinyString::from_format("OK:{:x}:{:x}", *frame,
+                                                    s_locals.lockstep_checkpoint_size));
+  return true;
+}
+
+static bool LoadLockstepCheckpoint(std::span<const u8> checkpoint, Error* error)
+{
+  if (checkpoint.size() < 20)
+    return false;
+  u32 state_bytes, wait_bytes;
+  std::memcpy(&state_bytes, checkpoint.data(), sizeof(state_bytes));
+  std::memcpy(&wait_bytes, checkpoint.data() + 4, sizeof(wait_bytes));
+  if (wait_bytes < 12 || (wait_bytes & 3) ||
+      static_cast<size_t>(state_bytes) + wait_bytes + 8 != checkpoint.size())
+    return false;
+  std::vector<u32> wait_state(wait_bytes / sizeof(u32));
+  std::memcpy(wait_state.data(), checkpoint.data() + 8 + state_bytes, wait_bytes);
+  if (!System::LoadStateDataFromBuffer(checkpoint.subspan(8, state_bytes), error))
+    return false;
+  TimingEvents::RestoreWaitState(wait_state);
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepCheckpointImport(ClientSocket* client, std::string_view data)
+{
+  const std::string_view frame_text = TakeLockstepField(&data);
+  const auto frame = StringUtil::FromChars<u32>(frame_text, 16);
+  const char* path = std::getenv("XPORT_LOCKSTEP_CHECKPOINT_FILE");
+  const bool prepare = data == "prepare";
+  if (!frame.has_value() || *frame == UINT32_MAX || !System::IsPaused() || System::IsExecuting() ||
+      !path || !*path || (!prepare && (!s_locals.lockstep_peer.IsAttached() ||
+      !s_locals.lockstep_replay_active || !s_locals.lockstep_frame_active ||
+      s_locals.lockstep_event_pending)))
+    return SendLockstepError(client, "checkpoint", "import_not_ready");
+  Error error;
+  auto source = FileSystem::OpenManagedCFile(path, "rb", &error);
+  if (!source || std::fseek(source.get(), 0, SEEK_END) != 0)
+    return SendLockstepError(client, "checkpoint", "import_open_failed");
+  const long length = std::ftell(source.get());
+  if (length <= 0 || static_cast<size_t>(length) >
+        System::GetMaxSaveStateSize(g_bus.ram_size > Bus::RAM_2MB_SIZE) + 65536 ||
+      std::fseek(source.get(), 0, SEEK_SET) != 0)
+    return SendLockstepError(client, "checkpoint", "import_size_invalid");
+  std::vector<u8> candidate(static_cast<size_t>(length));
+  if (std::fread(candidate.data(), 1, candidate.size(), source.get()) != candidate.size())
+    return SendLockstepError(client, "checkpoint", "import_read_failed");
+  if (prepare)
+  {
+    if (!LoadLockstepCheckpoint(candidate, &error))
+      return SendLockstepError(client, "checkpoint", "import_state_invalid");
+    client->SendReplyWithAck(TinyString::from_format("OK:{:x}:prepared", *frame));
+    return true;
+  }
+  s_locals.lockstep_checkpoint_state.swap(candidate);
+  s_locals.lockstep_checkpoint_size = static_cast<size_t>(length);
+  s_locals.lockstep_checkpoint_frame = *frame;
+  std::string restore_data(frame_text);
+  if (!data.empty())
+  {
+    restore_data.push_back(':');
+    restore_data.append(data);
+  }
+  return Cmd$qXportLockstepCheckpointRestore(client, restore_data);
+}
+
+bool GDBServer::Cmd$qXportLockstepCheckpointRestore(ClientSocket* client, std::string_view data)
+{
+  const std::string_view frame_text = TakeLockstepField(&data);
+  const auto frame = StringUtil::FromChars<u32>(frame_text, 16);
+  const auto target = data.empty() ? std::optional<u32>() : StringUtil::FromChars<u32>(data, 16);
+  if (!frame.has_value() || *frame == UINT32_MAX || !System::IsPaused() || System::IsExecuting() ||
+      !s_locals.lockstep_peer.IsAttached() || !s_locals.lockstep_replay_active ||
+      !s_locals.lockstep_frame_active || s_locals.lockstep_event_pending ||
+      !s_locals.lockstep_checkpoint_size || s_locals.lockstep_checkpoint_frame != *frame ||
+      (!data.empty() && (!target.has_value() || *target <= *frame + 1u)))
