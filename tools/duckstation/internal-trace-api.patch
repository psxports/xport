+bool AnalogController::SetTraceInput(u16 pressed_buttons, u32 axes)
+{
+  // Preserve serial mode and reject changes during an active response
+  if (!m_analog_mode || m_configuration_mode || m_analog_toggle_queued ||
+      (m_command != Command::Idle && m_command != Command::Ready))
+    return false;
+  m_button_state = pressed_buttons ^ UINT16_C(0xFFFF);
+  m_axis_state[static_cast<size_t>(Axis::RightX)] = static_cast<u8>(axes);
+  m_axis_state[static_cast<size_t>(Axis::RightY)] = static_cast<u8>(axes >> 8);
+  m_axis_state[static_cast<size_t>(Axis::LeftX)] = static_cast<u8>(axes >> 16);
+  m_axis_state[static_cast<size_t>(Axis::LeftY)] = static_cast<u8>(axes >> 24);
+  System::SetRunaheadReplayFlag(false);
+  return true;
+}
