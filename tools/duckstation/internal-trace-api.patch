+    return SendLockstepError(client, "replay", "invalid_record_identity");
+  s_locals.lockstep_record_identity = data;
+  s_locals.lockstep_replay_active = true;
+  s_locals.lockstep_input_queued = false;
+  s_locals.lockstep_frame_error.clear();
+  s_locals.lockstep_frame = 0;
+  s_locals.lockstep_checkpoint_state.clear();
+  s_locals.lockstep_checkpoint_candidate.clear();
+  s_locals.lockstep_checkpoint_size = 0;
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", data));
