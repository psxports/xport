+  None,
+  PreCall,
+  PostCall,
+  TailCall,
+  VBlank,
+  ModeTransition,
+  Fault,
+};
+
+struct MipsEvent
+{
+  MipsEventKind kind = MipsEventKind::None;
+  u64 sequence = 0;
+  u64 invocation = 0;
+  u64 parent_invocation = 0;
+  u32 context = 0;
+  u32 frame = 0;
+  u32 depth = 0;
