+bool GDBServer::Cmd$qXportCRTCState(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || !System::IsPaused() || System::IsExecuting())
+    return SendLockstepError(client, "crtc", "not_paused");
+  const auto state = GPU::GetXportCRTCState();
+  client->SendReplyWithAck(StringUtil::EncodeHex(state.data(), sizeof(state)));
+  return true;
+}
