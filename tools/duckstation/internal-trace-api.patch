+std::vector<u32> TimingEvents::CaptureWaitState()
+{
+  std::vector<u32> state{s_state.servicing_pc, static_cast<u32>(s_state.servicing_target),
+                         static_cast<u32>(s_state.servicing_target >> 32)};
+  state.insert(state.end(), s_state.serviced_wait_points.begin(), s_state.serviced_wait_points.end());
+  return state;
+}
 
+void TimingEvents::RestoreWaitState(std::span<const u32> state)
+{
+  Assert(state.size() >= 3);
+  s_state.servicing_pc = state[0];
+  s_state.servicing_target = static_cast<GlobalTicks>(state[1]) | (static_cast<GlobalTicks>(state[2]) << 32);
+  s_state.serviced_wait_points.assign(state.begin() + 3, state.end());
   UpdateCPUDowncount();
 }
 
+void TimingEvents::AfterInstruction(u32 pc)
+{
+  if (s_cpu_clock_enabled)
+    return;
+  const auto it = std::find(s_state.serviced_wait_points.begin(), s_state.serviced_wait_points.end(), pc);
+  if (it != s_state.serviced_wait_points.end())
+    s_state.serviced_wait_points.erase(it);
+}
