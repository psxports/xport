+  const auto frame = StringUtil::FromChars<u32>(frame_text, 16);
+  std::array<GDBServer::LockstepPadState, 2> states;
+  if (!s_locals.lockstep_replay_active || s_locals.lockstep_input_queued || !data.empty() ||
+      !frame.has_value() || !ParseLockstepPad(port0, &states[0]) || !ParseLockstepPad(port1, &states[1]))
+    return SendLockstepError(client, frame_text, "invalid_frame_input");
+  s_locals.lockstep_queued_frame = *frame;
+  s_locals.lockstep_queued_pad_state = states;
+  s_locals.lockstep_input_queued = true;
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", frame_text));
+  return true;
+}
