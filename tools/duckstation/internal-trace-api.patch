+bool GDBServer::Cmd$qXportLockstepNextEvent(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty())
+    return SendLockstepError(client, "event", "malformed_event_query");
+  if (!s_locals.lockstep_event_pending)
+  {
+    client->SendReplyWithAck("NONE");
+    return true;
+  }
+  s_locals.lockstep_peer.PublishDeviceTicks(SPU::GetXportSampleCounter(), TimingEvents::GetGlobalTickCounter());
+  const XportLockstep::MipsEvent& event = s_locals.lockstep_event;
+  const std::string_view mode = s_locals.lockstep_prefix_guard ? "PREFIX_GUARD" : "DETAILED";
+  if (event.kind == XportLockstep::MipsEventKind::ModeTransition)
+  {
+    const TinyString json = TinyString::from_format(
+      "{{\"schema\":1,\"contract\":\"xport-lockstep-event-v2\",\"side\":\"original\","
+      "\"kind\":\"MODE_TRANSITION\",\"mode\":\"DETAILED\",\"epoch\":{},\"event_sequence\":{},"
+      "\"frame\":{},\"image\":\"MAIN.EXE\",\"function\":null,\"parent_invocation\":0,"
+      "\"invocation\":0,\"depth\":0,\"call_ordinal\":0,\"callsite\":null,\"target\":null,"
+      "\"return_pc\":null,\"source\":{{\"previous_mode\":\"PREFIX_GUARD\","
+      "\"next_mode\":\"DETAILED\",\"target_frame\":{}}}}}",
+      s_locals.lockstep_epoch, event.sequence, event.frame, s_locals.lockstep_target_frame);
+    client->SendReplyWithAck("EVENT:" + StringUtil::EncodeHex(json.c_str(), json.length()));
+    s_locals.lockstep_event_pending = false;
+    return true;
+  }
+  if (event.kind == XportLockstep::MipsEventKind::VBlank || event.kind == XportLockstep::MipsEventKind::Fault)
+  {
+    const auto pad_name = [](u32 type) -> std::string_view {
+      return type == 1 ? "digital" : type == 2 ? "analog" : "disconnected";
+    };
+    const bool fault = event.kind == XportLockstep::MipsEventKind::Fault;
+    const TinyString json = fault ? TinyString::from_format(
+      "{{\"schema\":1,\"contract\":\"xport-lockstep-event-v2\",\"side\":\"original\","
+      "\"kind\":\"FAULT\",\"mode\":\"{}\",\"epoch\":{},\"event_sequence\":{},\"frame\":{},\"image\":\"MAIN.EXE\","
+      "\"function\":null,\"parent_invocation\":0,\"invocation\":0,\"depth\":0,"
+      "\"call_ordinal\":0,\"callsite\":null,\"target\":null,\"return_pc\":null,"
+      "\"source\":{{\"error\":\"{}\"}}}}", mode, s_locals.lockstep_epoch, event.sequence, event.frame, s_locals.lockstep_frame_error) :
+      TinyString::from_format(
+      "{{\"schema\":1,\"contract\":\"xport-lockstep-event-v2\",\"side\":\"original\","
+      "\"kind\":\"VBLANK\",\"mode\":\"{}\",\"epoch\":{},\"event_sequence\":{},\"frame\":{},\"image\":\"MAIN.EXE\","
+      "\"function\":null,\"parent_invocation\":0,\"invocation\":0,\"depth\":0,"
+      "\"call_ordinal\":0,\"callsite\":null,\"target\":null,\"return_pc\":null,"
+      "\"controller_state\":[{{\"type\":\"{}\",\"buttons\":{},\"analog\":{}}},"
+      "{{\"type\":\"{}\",\"buttons\":{},\"analog\":{}}}]}}",
+      mode, s_locals.lockstep_epoch, event.sequence, event.frame,
+      pad_name(s_locals.lockstep_pad_state[0].type), s_locals.lockstep_pad_state[0].buttons,
+      s_locals.lockstep_pad_state[0].analog, pad_name(s_locals.lockstep_pad_state[1].type),
+      s_locals.lockstep_pad_state[1].buttons, s_locals.lockstep_pad_state[1].analog);
+    client->SendReplyWithAck("EVENT:" + StringUtil::EncodeHex(json.c_str(), json.length()));
+    s_locals.lockstep_event_pending = false;
+    return true;
+  }
+  const std::string_view kind = event.kind == XportLockstep::MipsEventKind::PreCall ? "PRE_CALL" :
+                                event.kind == XportLockstep::MipsEventKind::PostCall ? "POST_CALL" : "TAIL_CALL";
+  const TinyString json = TinyString::from_format(
+    "{{\"schema\":1,\"contract\":\"xport-lockstep-event-v2\",\"side\":\"original\","
+    "\"kind\":\"{}\",\"mode\":\"{}\",\"epoch\":{},\"event_sequence\":{},\"frame\":{},\"image\":\"MAIN.EXE\","
+    "\"function\":\"0x{:08x}\",\"parent_invocation\":{},\"invocation\":{},\"depth\":{},"
+    "\"call_ordinal\":{},\"callsite\":\"0x{:08x}\",\"target\":\"0x{:08x}\","
+    "\"return_pc\":\"0x{:08x}\",\"instruction_word\":\"0x{:08x}\","
+    "\"instruction\":\"0x{:08x}\",\"delay_slot_pc\":\"0x{:08x}\","
+    "\"delay_slot_word\":\"0x{:08x}\",\"delay_slot\":\"0x{:08x}\","
+    "\"arguments\":[{},{},{},{}],\"return_value\":{},\"registers\":{{\"sp\":{},\"gp\":{},\"ra\":{},\"hi\":{},\"lo\":{}}},"
+    "\"link_register\":{},\"link_value\":{},\"gte_identity\":\"{:016x}\"}}",
+    kind, mode, s_locals.lockstep_epoch, event.sequence, event.frame, event.function, event.parent_invocation, event.invocation,
+    event.depth, event.call_ordinal, event.callsite, event.target, event.return_pc, event.instruction_word,
+    event.instruction_word, event.delay_slot_pc, event.delay_slot_word, event.delay_slot_word,
+    event.arguments[0], event.arguments[1], event.arguments[2], event.arguments[3], event.return_value, event.sp, event.gp,
+    event.ra, event.hi, event.lo, event.link_register, event.link_value, event.gte_identity);
+  client->SendReplyWithAck("EVENT:" + StringUtil::EncodeHex(json.c_str(), json.length()));
+  s_locals.lockstep_event_pending = false;
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepDMA(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || !System::IsPaused() || System::IsExecuting())
+    return SendLockstepError(client, "dma", "not_stopped");
+  SmallString reply("DMA");
+  for (u32 channel = 0; channel < DMA::NUM_CHANNELS; channel++)
+  {
+    const u32 offset = channel * 0x10;
+    reply.append_format(":{:08x}:{:08x}:{:08x}", DMA::ReadRegister(offset), DMA::ReadRegister(offset + 4),
+                        DMA::ReadRegister(offset + 8));
+  }
+  reply.append_format(":{:08x}:{:08x}", DMA::ReadRegister(0x70), DMA::ReadRegister(0x74));
+  client->SendReplyWithAck(reply);
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepPadRestore(ClientSocket* client, std::string_view data)
+{
+  const std::string_view frame_text = TakeLockstepField(&data);
+  const std::string_view port0 = TakeLockstepField(&data);
+  const std::string_view port1 = TakeLockstepField(&data);
+  const auto frame = StringUtil::FromChars<u32>(frame_text, 16);
+  std::array<GDBServer::LockstepPadState, 2> states;
+  if (!System::IsPaused() || System::IsExecuting() || !s_locals.lockstep_replay_active ||
+      !s_locals.lockstep_peer.IsAttached() || !frame.has_value() ||
+      *frame + 1u != s_locals.lockstep_frame || !data.empty() ||
+      !ParseLockstepPad(port0, &states[0]) || !ParseLockstepPad(port1, &states[1]))
+    return SendLockstepError(client, frame_text, "invalid_pad_restore");
+  std::string error;
+  if (!ApplyLockstepPads(states, &error))
+    return SendLockstepError(client, frame_text, error);
+  s_locals.lockstep_pad_state = states;
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", frame_text));
+  return true;
+}
