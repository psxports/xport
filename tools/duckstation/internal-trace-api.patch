+  const std::string_view count_text = TakeLockstepField(&data);
+  const auto offset = StringUtil::FromChars<u32>(offset_text, 16);
+  const auto count = StringUtil::FromChars<u32>(count_text, 16);
+  if (System::IsExecuting() || !System::IsPaused() || s_locals.function_coverage_active ||
+      !data.empty() || !offset.has_value() || !count.has_value() || !*count ||
+      *count > 64 || *offset > s_locals.function_coverage.GetCount())
+  {
+    return SendLockstepError(client, "coverage", "invalid_coverage_read");
+  }
+  const u32 total = s_locals.function_coverage.GetCount();
+  const u32 end = std::min(total, *offset + *count);
+  SmallString reply;
+  reply.append_format("COVERAGE:{:x}:{:x}:", total, *offset);
+  for (u32 index = *offset; index < end; index++)
+  {
+    if (index != *offset)
+      reply.append(';');
+    reply.append_format("{:x}", s_locals.function_coverage.GetFunction(index));
+  }
+  client->SendReplyWithAck(reply);
+  return true;
+}
