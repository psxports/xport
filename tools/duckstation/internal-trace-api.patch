+// Local diagnostic extension: caller supplies a hex-encoded basename, never a path.
+// GDB socket dispatch runs on the emulation thread. Require an already paused VM.
+template<bool save>
+bool GDBServer::Cmd$qFFState(ClientSocket* client, std::string_view data)
+{
+  if (!System::IsPaused() || System::IsExecuting() || FFTrace::stream || FFTrace::armed)
+  {
+    client->SendReplyWithAck("E10");
+    return true;
+  }
+  const auto decoded = StringUtil::DecodeHex(data);
+  if (!decoded || decoded->empty() || decoded->size() > 64)
+  {
+    client->SendReplyWithAck("E11");
+    return true;
+  }
+  std::string name(decoded->begin(), decoded->end());
+  for (const char c : name)
+  {
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+          (c >= '0' && c <= '9') || c == '-' || c == '_'))
+    {
+      client->SendReplyWithAck("E11");
+      return true;
+    }
+  }
+  const std::string path = Path::Combine(EmuFolders::SaveStates, "ff-audit-" + name + ".sav");
+  Error error;
+  bool success;
+  if constexpr (save)
+  {
+    if (FileSystem::FileExists(path.c_str()))
+    {
+      client->SendReplyWithAck("E12"); // Never overwrite a prior reference state.
+      return true;
+    }
+    std::promise<bool> completion;
+    auto future = completion.get_future();
+    success = System::SaveState(path, &error, false, false,
+      [&completion](bool result, const Error&) { completion.set_value(result); });
+    if (success)
+      success = future.get(); // Reply only after the file is atomically committed.
+  }
+  else
+  {
+    client->ClearBreakpoints(); // Clients must reinstall breakpoints after restore.
+    const auto result = System::LoadState(path.c_str(), &error, false, false);
+    success = result.has_value() && *result;
+  }
+  client->SendReplyWithAck(success ? "OK" : "E13");
+  return true;
+}
