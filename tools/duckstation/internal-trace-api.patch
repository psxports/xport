+bool GDBServer::Cmd$qXportSioDelay(ClientSocket* client, std::string_view data)
+{
+  const auto pc = StringUtil::FromChars<u32>(TakeLockstepField(&data), 16);
+  const auto start_pc = StringUtil::FromChars<u32>(data, 16);
+  if (!pc.has_value() || !start_pc.has_value() || (*pc & 3) || (*start_pc & 3) || System::IsExecuting())
+    return SendLockstepError(client, "sio", "invalid_delay_entry");
+  TimingEvents::SetSioDelay(*pc, *start_pc);
+  client->SendReplyWithAck("OK:sio");
+  return true;
+}
