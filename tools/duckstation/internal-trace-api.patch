+bool GDBServer::Cmd$qXportFastForward(ClientSocket* client, std::string_view data)
+{
+  if (!System::IsPaused() || (data != "0" && data != "1"))
+    return SendLockstepError(client, "presentation", "invalid_speed");
+  System::SetFastForwardEnabled(data == "1");
