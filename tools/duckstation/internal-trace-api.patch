+// SPDX-FileCopyrightText: 2026 xport contributors
+// SPDX-License-Identifier: CC-BY-NC-ND-4.0
+
+#pragma once
+
+#include "common/types.h"
+
+#include <array>
+#include <string_view>
+
+namespace XportLockstep {
+
+enum class MipsEventKind
+{
+  None,
+  PreCall,
+  PostCall,
+  TailCall,
+  VBlank,
+  ModeTransition,
+  Fault,
+};
+
+struct MipsEvent
+{
+  MipsEventKind kind = MipsEventKind::None;
+  u64 sequence = 0;
+  u64 invocation = 0;
+  u64 parent_invocation = 0;
+  u32 context = 0;
+  u32 frame = 0;
+  u32 depth = 0;
+  u32 call_ordinal = 0;
+  u32 function = 0;
+  u32 callsite = 0;
+  u32 target = 0;
+  u32 return_pc = 0;
+  u32 instruction_word = 0;
+  u32 delay_slot_pc = 0;
+  u32 delay_slot_word = 0;
+  u32 link_register = 0;
+  u32 link_value = 0;
+  std::array<u32, 4> arguments{};
+  u32 return_value = 0;
+  u32 sp = 0;
+  u32 gp = 0;
+  u32 ra = 0;
+  u32 hi = 0;
+  u32 lo = 0;
+  u64 gte_identity = 0;
+};
+
+class MipsCallTracker final
+{
+public:
+  static constexpr u32 MAX_DEPTH = 64;
+  static constexpr u32 MAX_CONTEXTS = 8;
+  static constexpr u32 MAX_TAIL_CALLS = 64;
+  static constexpr u32 MAX_BOUNDARY_TARGETS = 2048;
+
+  void Reset();
+  void ResetEpoch();
+  void ResetCheckpointEpoch();
+  bool ModeTransition(u32 frame, MipsEvent* event);
+  bool AddBoundaryTarget(u32 target);
+  bool AddReviewedTailCall(u32 source, u32 target);
+  bool BeforeInstruction(u32 pc, u32 word, const u32* registers, u32 hi, u32 lo, const u32* gte_registers,
+                         bool prior_branch_taken, MipsEvent* event);
+  bool EnterException(u32 vector, u32 return_pc);
+  bool FrameDone(u32 frame, bool fault, MipsEvent* event);
+
+private:
+  enum class PendingKind
+  {
+    None,
+    Call,
+    Return,
+    Tail,
+    ExceptionReturn,
+  };
+
+  struct Pending
+  {
+    PendingKind kind = PendingKind::None;
+    u32 callsite = 0;
+    u32 target = 0;
+    u32 return_pc = 0;
+    u32 word = 0;
+    u32 link_register = 0;
+    u32 delay_pc = 0;
+    u32 delay_word = 0;
+    bool conditional = false;
+    bool delay_seen = false;
+    bool taken = false;
+  };
+
+  struct Frame
+  {
+    u64 invocation = 0;
+    u64 parent_invocation = 0;
+    u32 function = 0;
+    u32 callsite = 0;
+    u32 return_pc = 0;
+    u32 call_ordinal = 0;
+    u32 next_call_ordinal = 0;
+    u32 instruction_word = 0;
+    u32 delay_pc = 0;
+    u32 delay_word = 0;
+    u32 link_register = 0;
+  };
+
+  struct Context
+  {
+    u32 id = 0;
+    u32 exception_return_pc = 0;
+    u32 depth = 0;
+    bool rfe_seen = false;
+    Pending pending;
+    std::array<Frame, MAX_DEPTH> frames{};
+  };
+
+  struct TailCall
+  {
+    u32 source = 0;
+    u32 target = 0;
+  };
+
+  static bool IsJumpRegister(u32 word, u32 function);
+  static void CaptureRegisters(const u32* registers, u32 hi, u32 lo, const u32* gte_registers, MipsEvent* event);
+  bool IsReviewedTailCall(u32 source, u32 target) const;
+  bool IsBoundaryTarget(u32 target) const;
+  bool CompletePending(Context* context, u32 pc, const u32* registers, u32 hi, u32 lo,
+                       const u32* gte_registers, MipsEvent* event);
+
+  std::array<Context, MAX_CONTEXTS> m_contexts{};
+  std::array<TailCall, MAX_TAIL_CALLS> m_tail_calls{};
+  std::array<u32, MAX_BOUNDARY_TARGETS> m_boundary_targets{};
+  u32 m_context_depth = 1;
+  u32 m_tail_call_count = 0;
+  u32 m_boundary_target_count = 0;
+  u32 m_next_context = 1;
+  u64 m_next_invocation = 1;
+  u32 m_next_root_call_ordinal = 0;
+  u64 m_sequence = 0;
+};
+
+class MipsFunctionCoverage final
+{
+public:
+  static constexpr u32 MAX_FUNCTIONS = MipsCallTracker::MAX_BOUNDARY_TARGETS;
+  static constexpr u32 HASH_CAPACITY = MAX_FUNCTIONS * 2;
+  static_assert((HASH_CAPACITY & (HASH_CAPACITY - 1)) == 0);
+
+  void Reset();
+  bool AddTarget(u32 target);
+  bool BeforeInstruction(u32 pc);
+  u32 GetCount() const { return m_count; }
+  u32 GetFunction(u32 index) const { return index < m_count ? m_order[index] : 0; }
+
+private:
+  static bool Contains(const std::array<u32, HASH_CAPACITY>& table, u32 address);
+  static bool Insert(std::array<u32, HASH_CAPACITY>* table, u32 address);
+
+  std::array<u32, HASH_CAPACITY> m_targets{};
+  std::array<u32, HASH_CAPACITY> m_seen{};
+  std::array<u32, MAX_FUNCTIONS> m_order{};
+  u32 m_target_count = 0;
+  u32 m_count = 0;
+};
+
+inline void MipsFunctionCoverage::Reset()
+{
+  m_targets = {};
+  m_seen = {};
+  m_order = {};
+  m_target_count = 0;
+  m_count = 0;
+}
+
+inline bool MipsFunctionCoverage::Contains(const std::array<u32, HASH_CAPACITY>& table, u32 address)
+{
+  constexpr u32 mask = HASH_CAPACITY - 1;
+  u32 index = (address * 2654435761u) & mask;
+  for (u32 probe = 0; probe < HASH_CAPACITY; probe++)
+  {
+    const u32 slot = table[index];
+    if (slot == address)
+      return true;
+    if (!slot)
+      return false;
+    index = (index + 1) & mask;
+  }
+  return false;
+}
+
+inline bool MipsFunctionCoverage::Insert(std::array<u32, HASH_CAPACITY>* table, u32 address)
+{
+  constexpr u32 mask = HASH_CAPACITY - 1;
+  u32 index = (address * 2654435761u) & mask;
+  for (u32 probe = 0; probe < HASH_CAPACITY; probe++)
+  {
+    u32& slot = (*table)[index];
+    if (slot == address)
+      return false;
+    if (!slot)
+    {
+      slot = address;
+      return true;
+    }
+    index = (index + 1) & mask;
+  }
+  return false;
+}
+
+inline bool MipsFunctionCoverage::AddTarget(u32 target)
+{
+  if (!target || (target & 3u) || m_target_count >= MAX_FUNCTIONS || !Insert(&m_targets, target))
+    return false;
+  m_target_count++;
+  return true;
+}
+
+inline bool MipsFunctionCoverage::BeforeInstruction(u32 pc)
+{
+  if (!Contains(m_targets, pc) || !Insert(&m_seen, pc))
+    return false;
+  if (m_count >= MAX_FUNCTIONS)
+    return false;
+  m_order[m_count++] = pc;
+  return true;
+}
+
+inline void MipsCallTracker::Reset()
+{
+  m_contexts = {};
+  m_context_depth = 1;
+  m_contexts[0].id = 0;
+  m_tail_calls = {};
+  m_tail_call_count = 0;
+  m_boundary_targets = {};
+  m_boundary_target_count = 0;
+  m_next_context = 1;
+  m_next_invocation = 1;
+  m_next_root_call_ordinal = 0;
+  m_sequence = 0;
+}
+
+inline void MipsCallTracker::ResetEpoch()
+{
+  m_contexts = {};
+  m_context_depth = 1;
+  m_contexts[0].id = 0;
+  m_next_context = 1;
+  m_next_invocation = 1;
+  m_next_root_call_ordinal = 0;
+}
+
+inline void MipsCallTracker::ResetCheckpointEpoch()
+{
+  ResetEpoch();
+  m_sequence = 0;
+}
+
+inline bool MipsCallTracker::ModeTransition(u32 frame, MipsEvent* event)
+{
+  *event = {};
+  event->kind = MipsEventKind::ModeTransition;
+  event->sequence = m_sequence++;
+  event->frame = frame;
+  return true;
+}
+
+inline bool MipsCallTracker::AddBoundaryTarget(u32 target)
+{
+  if ((target & 3u) || m_boundary_target_count >= MAX_BOUNDARY_TARGETS)
+    return false;
+  u32 index = 0;
+  while (index < m_boundary_target_count && m_boundary_targets[index] < target)
+    index++;
+  if (index < m_boundary_target_count && m_boundary_targets[index] == target)
+    return false;
+  for (u32 move = m_boundary_target_count; move > index; move--)
+    m_boundary_targets[move] = m_boundary_targets[move - 1];
+  m_boundary_targets[index] = target;
+  m_boundary_target_count++;
+  return true;
+}
+
+inline bool MipsCallTracker::AddReviewedTailCall(u32 source, u32 target)
+{
+  if ((source & 3u) || (target & 3u) || m_tail_call_count >= MAX_TAIL_CALLS)
+    return false;
+  m_tail_calls[m_tail_call_count++] = {source, target};
+  return true;
+}
+
+inline bool MipsCallTracker::IsJumpRegister(u32 word, u32 function)
+{
+  return (word >> 26) == 0 && (word & 0x3fu) == function;
+}
+
+inline bool MipsCallTracker::IsReviewedTailCall(u32 source, u32 target) const
+{
+  for (u32 index = 0; index < m_tail_call_count; index++)
+  {
+    if (m_tail_calls[index].source == source && m_tail_calls[index].target == target)
+      return true;
+  }
+  return false;
+}
+
+inline bool MipsCallTracker::IsBoundaryTarget(u32 target) const
+{
+  u32 first = 0;
+  u32 last = m_boundary_target_count;
+  while (first < last)
+  {
+    const u32 middle = first + ((last - first) / 2);
+    if (m_boundary_targets[middle] < target)
+      first = middle + 1;
+    else
+      last = middle;
+  }
+  return first < m_boundary_target_count && m_boundary_targets[first] == target;
+}
+
+inline void MipsCallTracker::CaptureRegisters(const u32* registers, u32 hi, u32 lo, const u32* gte_registers,
+                                              MipsEvent* event)
+{
+  for (u32 index = 0; index < 4; index++)
+    event->arguments[index] = registers[4 + index];
+  event->sp = registers[29];
+  event->gp = registers[28];
+  event->ra = registers[31];
+  event->hi = hi;
+  event->lo = lo;
+  event->return_value = registers[2];
+  u64 identity = UINT64_C(1469598103934665603);
+  for (u32 index = 0; gte_registers && index < 64; index++)
+  {
+    identity ^= gte_registers[index];
+    identity *= UINT64_C(1099511628211);
+  }
+  event->gte_identity = gte_registers ? identity : 0;
+}
+
+inline bool MipsCallTracker::CompletePending(Context* context, u32 pc, const u32* registers, u32 hi, u32 lo,
+                                             const u32* gte_registers, MipsEvent* event)
+{
+  Pending& pending = context->pending;
+  if (pending.kind == PendingKind::None)
+    return false;
+  if (!pending.delay_seen)
+  {
+    if (pc == pending.callsite + 4u)
+    {
+      pending.delay_seen = true;
+      pending.delay_pc = pc;
+      pending.delay_word = 0;
+      pending.taken = true;
+    }
+    return false;
+  }
+  if (pending.conditional && !pending.taken)
+  {
+    pending = {};
+    return false;
+  }
+  if (pending.kind == PendingKind::ExceptionReturn)
+  {
+    pending = {};
+    if (m_context_depth > 1)
+      m_context_depth--;
+    return false;
+  }
+  if (pending.kind == PendingKind::Return)
+  {
+    if (!context->depth)
+    {
+      pending = {};
+      return false;
+    }
+    const Frame frame = context->frames[--context->depth];
+    *event = {};
+    event->kind = MipsEventKind::PostCall;
+    event->sequence = m_sequence++;
+    event->invocation = frame.invocation;
+    event->parent_invocation = frame.parent_invocation;
+    event->context = context->id;
+    event->depth = context->depth;
+    event->call_ordinal = frame.call_ordinal;
+    event->function = frame.function;
+    event->callsite = frame.callsite;
+    event->target = frame.function;
+    event->return_pc = frame.return_pc;
+    event->instruction_word = pending.word;
+    event->delay_slot_pc = pending.delay_pc;
+    event->delay_slot_word = pending.delay_word;
+    event->link_register = frame.link_register;
+    CaptureRegisters(registers, hi, lo, gte_registers, event);
+    event->link_value = frame.link_register < 32 ? registers[frame.link_register] : 0;
+    pending = {};
+    return true;
+  }
+  if (!IsBoundaryTarget(pending.target))
+  {
+    pending = {};
+    return false;
+  }
+  if (context->depth >= MAX_DEPTH)
+  {
+    pending = {};
+    return false;
+  }
+  Frame frame;
+  frame.invocation = m_next_invocation++;
+  frame.parent_invocation = context->depth ? context->frames[context->depth - 1].invocation : 0;
+  frame.call_ordinal = context->depth ? context->frames[context->depth - 1].next_call_ordinal++ :
+                                        m_next_root_call_ordinal++;
+  frame.function = pending.target;
+  frame.callsite = pending.callsite;
+  frame.return_pc = pending.return_pc;
+  frame.instruction_word = pending.word;
+  frame.delay_pc = pending.delay_pc;
+  frame.delay_word = pending.delay_word;
+  frame.link_register = pending.link_register;
+  if (pending.kind == PendingKind::Tail && context->depth)
+  {
+    const Frame& replaced = context->frames[context->depth - 1];
+    frame.parent_invocation = replaced.parent_invocation;
+    frame.call_ordinal = replaced.call_ordinal;
+    frame.return_pc = replaced.return_pc;
+    context->depth--;
+  }
+  context->frames[context->depth++] = frame;
+  *event = {};
+  event->kind = pending.kind == PendingKind::Tail ? MipsEventKind::TailCall : MipsEventKind::PreCall;
+  event->sequence = m_sequence++;
+  event->invocation = frame.invocation;
+  event->parent_invocation = frame.parent_invocation;
+  event->context = context->id;
+  event->depth = context->depth - 1;
+  event->call_ordinal = frame.call_ordinal;
+  event->function = frame.function;
+  event->callsite = frame.callsite;
+  event->target = frame.function;
+  event->return_pc = frame.return_pc;
+  event->instruction_word = frame.instruction_word;
+  event->delay_slot_pc = frame.delay_pc;
+  event->delay_slot_word = frame.delay_word;
+  event->link_register = frame.link_register;
+  CaptureRegisters(registers, hi, lo, gte_registers, event);
+  event->link_value = frame.link_register < 32 ? registers[frame.link_register] : 0;
+  pending = {};
+  return true;
+}
+
+inline bool MipsCallTracker::BeforeInstruction(u32 pc, u32 word, const u32* registers, u32 hi, u32 lo,
+                                               const u32* gte_registers,
+                                               bool prior_branch_taken, MipsEvent* event)
+{
+  Context* context = &m_contexts[m_context_depth - 1];
+  if (context->pending.kind != PendingKind::None)
+  {
+    if (!context->pending.delay_seen && pc == context->pending.callsite + 4u)
+    {
+      context->pending.delay_seen = true;
+      context->pending.delay_pc = pc;
+      context->pending.delay_word = word;
+      context->pending.taken = prior_branch_taken;
+      return false;
+    }
+    if (context->pending.delay_seen)
+    {
+      const u32 previous_context_depth = m_context_depth;
+      if (CompletePending(context, pc, registers, hi, lo, gte_registers, event))
+        return true;
+      if (m_context_depth != previous_context_depth)
+        return BeforeInstruction(pc, word, registers, hi, lo, gte_registers, prior_branch_taken, event);
+    }
+    context = &m_contexts[m_context_depth - 1];
+  }
+  if (context->depth && pc == context->frames[context->depth - 1].return_pc)
+  {
+    const Frame frame = context->frames[--context->depth];
+    *event = {};
+    event->kind = MipsEventKind::PostCall;
+    event->sequence = m_sequence++;
+    event->invocation = frame.invocation;
+    event->parent_invocation = frame.parent_invocation;
+    event->context = context->id;
+    event->depth = context->depth;
+    event->call_ordinal = frame.call_ordinal;
+    event->function = frame.function;
+    event->callsite = frame.callsite;
+    event->target = frame.function;
+    event->return_pc = frame.return_pc;
+    event->instruction_word = word;
+    event->link_register = frame.link_register;
+    CaptureRegisters(registers, hi, lo, gte_registers, event);
+    event->link_value = frame.link_register < 32 ? registers[frame.link_register] : 0;
+    return true;
+  }
+  if (word == 0x42000010u)
+  {
+    context->rfe_seen = true;
+    if (m_context_depth > 1)
+    {
+      context->pending.kind = PendingKind::ExceptionReturn;
+      context->pending.delay_seen = true;
+    }
+    return false;
+  }
+
+  const u32 opcode = word >> 26;
+  Pending pending;
+  pending.callsite = pc;
+  pending.word = word;
+  pending.return_pc = pc + 8u;
+  if (opcode == 3u)
+  {
+    pending.kind = PendingKind::Call;
+    pending.target = ((pc + 4u) & 0xf0000000u) | ((word & 0x03ffffffu) << 2);
+    pending.link_register = 31;
+  }
+  else if (IsJumpRegister(word, 9u))
+  {
+    pending.target = registers[(word >> 21) & 31u];
+    pending.link_register = (word >> 11) & 31u;
+    pending.kind = pending.link_register ? PendingKind::Call : PendingKind::None;
+  }
+  else if (opcode == 1u && (((word >> 16) & 31u) == 16u || ((word >> 16) & 31u) == 17u))
+  {
+    pending.kind = PendingKind::Call;
+    pending.conditional = true;
+    pending.target = pc + 4u + (static_cast<s32>(static_cast<s16>(word)) << 2);
+    pending.link_register = 31;
+  }
+  else if (IsJumpRegister(word, 8u))
+  {
+    pending.target = registers[(word >> 21) & 31u];
+    if (context->rfe_seen && m_context_depth > 1)
+      pending.kind = PendingKind::ExceptionReturn;
+    else if (context->depth && pending.target == context->frames[context->depth - 1].return_pc)
+      pending.kind = PendingKind::Return;
+    else if (IsReviewedTailCall(pc, pending.target))
+      pending.kind = PendingKind::Tail;
+  }
+  else if (opcode == 2u)
+  {
+    pending.target = ((pc + 4u) & 0xf0000000u) | ((word & 0x03ffffffu) << 2);
+    if (IsReviewedTailCall(pc, pending.target))
+      pending.kind = PendingKind::Tail;
+  }
+  if (pending.kind != PendingKind::None)
+    context->pending = pending;
+  return false;
+}
+
+inline bool MipsCallTracker::EnterException(u32 vector, u32 return_pc)
+{
+  if (m_context_depth >= MAX_CONTEXTS)
+    return false;
+  Context& context = m_contexts[m_context_depth++];
+  context = {};
+  context.id = m_next_context++;
+  context.exception_return_pc = return_pc;
+  static_cast<void>(vector);
+  return true;
+}
+
+inline bool MipsCallTracker::FrameDone(u32 frame, bool fault, MipsEvent* event)
+{
+  *event = {};
+  event->kind = fault ? MipsEventKind::Fault : MipsEventKind::VBlank;
+  event->sequence = m_sequence++;
+  event->frame = frame;
+  return true;
+}
+
+} // Namespace XportLockstep
