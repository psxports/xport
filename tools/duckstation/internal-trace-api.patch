+void GDBServer::OnTracePad(u32 port, u32 device, u8 outgoing, u8 incoming, bool ack)
+{
+  if (!FFTrace::stream || !FFTrace::vblank_enabled)
+    return;
+  const auto ticks = FFTrace::ReadClock();
+  std::vector<u8> payload;
+  for (u32 value : {System::GetFrameNumber(), static_cast<u32>(ticks), static_cast<u32>(ticks >> 32),
+                    port, device, static_cast<u32>(outgoing), static_cast<u32>(incoming), ack ? 1u : 0u})
+    FFTrace::Number(payload, value);
+  FFTrace::Emit(11, FFTrace::Read(0x80093dd0), payload);
+}
