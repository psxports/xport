+// Project-configured diagnostics executed on the emulation thread
+#include <cstdio>
+#include <cstring>
+#include <array>
+#include <unordered_map>
+#include <unordered_set>
+#include "common/sha256_digest.h"
+#include "ff_trace_writer.h"
+#include <chrono>
+#include "gpu.h"
+#include "spu.h"
+#include "save_state_version.h"
+#include "util/state_wrapper.h"
+
+namespace FFTrace {
+static FILE* stream = nullptr;
+static FFTraceWriter writer;
+static bool failed = false;
+static bool armed = false;
+static u32 end_tick = 0;
+static u32 detail_from = UINT32_MAX, detail_to = 0;
+static bool vblank_enabled = false;
+static u32 last_vblank = UINT32_MAX, vblank_count = 0;
+static std::chrono::steady_clock::time_point previous_vblank_wall;
+static std::vector<u8> previous_memory;
+struct PageContentRecord { u32 id; std::vector<u8> data; u32 references; };
+static std::unordered_map<std::string, std::vector<PageContentRecord>> page_contents;
+static std::array<u32, 513> previous_page_ids{};
+static u32 next_page_content = 1;
+static bool states_enabled = false;
+static std::string trace_name;
+static u64 next_state_tick = 0;
+static u32 state_index = 0, state_prepare_us = 0;
+static std::future<bool> state_pending;
+static bool user_mode = false;
+static u64 user_end_tick = 0;
+static u64 last_observed_clock = 0;
+static std::string initial_settings;
+static void Close(u32 tick, bool complete);
+static u32 requested = 0;
+static u32 last_boundary = UINT32_MAX;
+static std::vector<u8> schedule;
+#include "xport_trace_profile.inl"
+static std::vector<u32> sites;
+
+static u32 Word(const u8* data)
+{
+  u32 value;
+  std::memcpy(&value, data, 4);
+  return value;
+}
+
+static void Number(std::vector<u8>& data, u32 value)
+{
+  const auto* bytes = reinterpret_cast<const u8*>(&value);
+  data.insert(data.end(), bytes, bytes + 4);
+}
+
+static u32 PageContent(const u8* data, u32 size, bool* fresh)
+{
+  const auto digest = SHA256Digest::GetDigest(data, size);
+  const std::string key(reinterpret_cast<const char*>(digest.data()), digest.size());
+  auto& candidates = page_contents[key];
+  for (PageContentRecord& candidate : candidates)
+  {
+    if (candidate.data.size() == size && std::memcmp(candidate.data.data(), data, size) == 0)
+    {
+      candidate.references++;
+      *fresh = false;
+      return candidate.id;
+    }
+  }
+  if (next_page_content == UINT32_MAX)
+  {
+    failed = true;
+    return 0;
+  }
+  const u32 id = next_page_content++;
+  candidates.push_back({id, std::vector<u8>(data, data + size), 1});
+  *fresh = true;
+  return id;
+}
+
+static void ReleasePageContent(u32 id)
+{
+  if (!id)
+    return;
+  for (auto group = page_contents.begin(); group != page_contents.end(); group++)
+  {
+    auto& candidates = group->second;
+    for (auto candidate = candidates.begin(); candidate != candidates.end(); candidate++)
+    {
+      if (candidate->id != id)
+        continue;
+      if (--candidate->references == 0)
+        candidates.erase(candidate);
+      if (candidates.empty())
+        page_contents.erase(group);
+      return;
+    }
+  }
+  failed = true;
+}
+
+static u64 ReadClock()
+{
+  const u64 ticks = System::GetGlobalTickCounter();
+  last_observed_clock = std::max(last_observed_clock, ticks);
+  return ticks;
+}
+
+static bool RAM(std::vector<u8>& data, u32 address, u32 size)
+{
+  const size_t offset = data.size();
+  data.resize(offset + size);
+  return CPU::SafeReadMemoryBytes(address, data.data() + offset, size);
+}
+
+static u32 Read(u32 address)
+{
+  u32 value = 0;
+  if (!CPU::SafeReadMemoryWord(address, &value))
+    failed = true;
+  return value;
+}
+
+static void Emit(u32 type, u32 tick, const std::vector<u8>& data)
+{
+  std::vector<u8> record;
+  record.reserve(12 + data.size());
+  Number(record, type);
+  Number(record, tick);
+  Number(record, static_cast<u32>(data.size()));
+  record.insert(record.end(), data.begin(), data.end());
+  if (!writer.Write(std::move(record)))
+    failed = true;
+}
+
+#include "ff_stage_package.inl"
+
+static std::string EffectiveSettings()
+{
+  INISettingsInterface settings;
+  g_settings.Save(settings, false, false);
+  return settings.SaveToString() + "\n" + profile_text;
+}
+
+static void SettingsChanged()
+{
+  if (!stream || !user_mode)
+    return;
+  const std::string current = EffectiveSettings();
+  if (current != initial_settings)
+  {
+    Emit(14, Read(profile.game_tick), std::vector<u8>(current.begin(), current.end()));
+    failed = true;
+  }
+}
+
+static void FinishState(bool wait)
+{
+  if (!state_pending.valid() || (!wait && state_pending.wait_for(std::chrono::seconds(0)) != std::future_status::ready))
+    return;
+  const bool success = state_pending.get();
+  std::vector<u8> payload;
+  Number(payload, state_index - 1);
+  Number(payload, success ? 1 : 0);
+  Number(payload, state_prepare_us);
+  Emit(10, Read(profile.game_tick), payload);
+  failed |= !success;
+}
+
+static void SaveCheckpoint()
+{
+  FinishState(false);
+  const u64 ticks = ReadClock();
+  if (!states_enabled || ticks < next_state_tick)
+    return;
+  if (state_pending.valid())
+  {
+    failed = true;
+    return;
+  }
+  const std::string name = "trace-" + trace_name + "-" + std::to_string(state_index);
+  const std::string path = Path::Combine(EmuFolders::SaveStates, "ff-audit-" + name + ".sav");
+  if (FileSystem::FileExists(path.c_str()))
+  {
+    failed = true;
+    return;
+  }
+  std::vector<u8> payload;
+  Number(payload, state_index++);
+  Number(payload, System::GetFrameNumber());
+  Number(payload, static_cast<u32>(ticks));
+  Number(payload, static_cast<u32>(ticks >> 32));
+  Number(payload, CPU::g_state.pc);
+  payload.insert(payload.end(), name.begin(), name.end());
+  Emit(9, Read(profile.game_tick), payload);
+  auto completion = std::make_shared<std::promise<bool>>();
+  state_pending = completion->get_future();
+  Error error;
+  const auto begin = std::chrono::steady_clock::now();
+  const bool scheduled = System::SaveState(path, &error, false, true,
+    [completion](bool result, const Error&) { completion->set_value(result); }, 0);
+  state_prepare_us = static_cast<u32>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - begin).count());
+  if (!scheduled)
+    completion->set_value(false);
+  next_state_tick = ticks + static_cast<u64>(System::GetTicksPerSecond()) * 10;
+}
+
+static void VBlank()
+{
+  if (!stream || !vblank_enabled)
+    return;
+  const auto capture_started = std::chrono::steady_clock::now();
+  const u32 wall_interval_us = vblank_count ? static_cast<u32>(std::chrono::duration_cast<std::chrono::microseconds>(capture_started - previous_vblank_wall).count()) : 0;
+  previous_vblank_wall = capture_started;
+  const u32 frame = System::GetFrameNumber();
+  if (last_vblank != UINT32_MAX && frame != last_vblank + 1)
+  {
+    failed = true;
+    return;
+  }
+  std::vector<u8> memory;
+  if (!RAM(memory, 0x80000000, 0x200000) || !RAM(memory, 0x1f800000, 1024))
+  {
+    failed = true;
+    return;
+  }
+  const bool first = previous_memory.empty();
+  const bool keyframe = !first && vblank_count % 600 == 0;
+  const auto ticks = ReadClock();
+  std::vector<u8> payload;
+  Number(payload, frame);
+  Number(payload, static_cast<u32>(ticks));
+  Number(payload, static_cast<u32>(ticks >> 32));
+  Number(payload, keyframe ? 3 : 2);
+  Number(payload, 0);
+  u32 changed = 0;
+  for (u32 page = 0; page <= 512; page++)
+  {
+    const u32 offset = page * 4096, size = page == 512 ? 1024 : 4096;
+    if (keyframe)
+    {
+      Number(payload, page);
+      Number(payload, previous_page_ids[page]);
+      changed++;
+      continue;
+    }
+    if (!first && !keyframe && std::memcmp(memory.data() + offset, previous_memory.data() + offset, size) == 0)
+      continue;
+    Number(payload, page);
+    bool fresh = false;
+    const u32 content = PageContent(memory.data() + offset, size, &fresh);
+    ReleasePageContent(previous_page_ids[page]);
+    previous_page_ids[page] = content;
+    Number(payload, content);
+    if (!keyframe)
+    {
+      Number(payload, fresh ? 1 : 0);
+      if (fresh)
+        payload.insert(payload.end(), memory.data() + offset, memory.data() + offset + size);
+    }
+    changed++;
+  }
+  std::memcpy(payload.data() + 16, &changed, 4);
+  Emit(8, Read(profile.game_tick), payload);
+  previous_memory = std::move(memory);
+  last_vblank = frame;
+  vblank_count++;
+  const u32 previous_state_index = state_index;
+  SaveCheckpoint();
+  if (user_mode)
+  {
+    const u32 capture_us = static_cast<u32>(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now() - capture_started).count());
+    std::vector<u8> timing;
+    for (u32 value : {frame, capture_us, wall_interval_us, keyframe ? 1u : 0u, state_index != previous_state_index ? 1u : 0u})
+      Number(timing, value);
+    Emit(18, Read(profile.game_tick), timing);
+  }
+  if (user_mode && ticks >= user_end_tick)
+    Close(Read(profile.game_tick), true);
+}
+
+static bool Boundary(u32 tick)
+{
+  if (!user_mode && last_boundary == tick)
+    return true;
+  if (!user_mode && last_boundary != UINT32_MAX && tick != last_boundary + 1)
+    return false;
+  last_boundary = tick;
+  if (tick >= detail_from && tick <= detail_to)
+  {
+    std::vector<u8> detail;
+    if (!RAM(detail, 0x80000000, 0x200000) || !RAM(detail, 0x1f800000, 1024))
+      return false;
+    Emit(6, tick, detail);
+    std::vector<u8> registers;
+    Number(registers, CPU::g_state.pc);
+    for (u32 i = 0; i < 32; i++)
+      Number(registers, CPU::g_state.regs.r[i]);
+    Emit(7, tick, registers);
+  }
+  std::vector<u8> actors;
+  if (!RAM(actors, profile.actors, profile.actors_size) || !RAM(actors, profile.camera, profile.camera_size))
+    return false;
+  Emit(1, tick, actors);
+  std::vector<u8> world;
+  const u32 count = Read(profile.world_count);
+  if (count > profile.world_max_count)
+    return false;
+  Number(world, count);
+  if (!RAM(world, profile.world_a, profile.world_a_size) || !RAM(world, profile.world_b, profile.world_b_size) ||
+      !RAM(world, profile.world_dynamic, count * profile.world_item_size) || !RAM(world, profile.world_c, profile.world_c_size) ||
+      !RAM(world, profile.world_scalar_a, 4) || !RAM(world, profile.world_scalar_b, 4))
+    return false;
+  const u32 ot = Read(profile.ot_pointer) & 0x1fffff;
+  const u32 cursor = Read(profile.gpu_cursor_pointer) & 0x1fffff;
+  const u32 start = cursor >= profile.gpu_pool_split ? profile.gpu_pool_split : profile.gpu_pool_low;
+  if (cursor < start || cursor > profile.gpu_pool_end)
+    return false;
+  auto valid = [=](u32 address, u32 size) {
+    if (profile.gpu_full_ram)
+      return address < 0x200000u && size <= 0x200000u - address;
+    return (address >= ot && address + size <= ot + profile.ot_size) ||
+           (address >= start && address + size <= cursor);
+  };
+  std::unordered_set<u32> seen;
+  u32 address = ot;
+  while (address != profile.ot_end)
+  {
+    if (seen.size() >= 131072 || !seen.insert(address).second || !valid(address, 4))
+      return false;
+    const u32 tag = Read(0x80000000 | address);
+    const u32 words = tag >> 24;
+    if (words)
+    {
+      if (!valid(address + 4, words * 4))
+        return false;
+      Number(world, words);
+      if (!RAM(world, 0x80000000 | (address + 4), words * 4))
+        return false;
+    }
+    address = tag & 0xffffff;
+  }
+  Number(world, 0);
+  Emit(2, tick, world);
+  return !failed;
+}
+
+static void Close(u32 tick, bool complete)
+{
+  if (!stream)
+    return;
+  SettingsChanged();
+  FinishState(true);
+  if (user_mode)
+    failed |= !FinishStagePackages(complete && !failed);
+  if (user_mode)
+  {
+    ReadClock();
+    // Cover event callbacks even when their pending ticks exceed the paused CPU clock
+    const u64 now = last_observed_clock;
+    std::vector<u8> summary;
+    Number(summary, static_cast<u32>(now));
+    Number(summary, static_cast<u32>(now >> 32));
+    Number(summary, vblank_count);
+    Number(summary, static_cast<u32>(writer.Peak()));
+    Emit(13, tick, summary);
+  }
+  std::vector<u8> footer;
+  Number(footer, complete && !failed ? 1 : 0);
+  Emit(5, tick, footer);
+  if (!writer.Finish())
+    failed = true;
+  stream = nullptr;
+}
+
+static bool PhaseGPU(u32 pc, u32 tick)
+{
+  std::vector<u8> payload;
+  Number(payload, pc);
+  const u32 phase_bit = pc == profile.game_begin ? 1u : pc == profile.menu_phase ? 2u :
+                        pc == profile.sequence_phase ? 4u : 8u;
+  if (!(profile.gpu_phase_mask & phase_bit))
+  {
+    Number(payload, 0);
+    Emit(17, tick, payload);
+    return !failed;
+  }
+  std::unordered_set<u32> seen;
+  u32 address = Read(profile.ot_pointer) & 0x1fffff;
+  while (address != profile.ot_end)
+  {
+    if (address >= 0x200000 || (address & 3) || seen.size() >= 131072 || !seen.insert(address).second)
+      return false;
+    const u32 tag = Read(0x80000000 | address), words = tag >> 24;
+    if (address + 4 + words * 4 > 0x200000 || payload.size() + 8 + words * 4 > 0x200000)
+      return false;
+    if (words)
+    {
+      Number(payload, words);
+      if (!RAM(payload, 0x80000000 | (address + 4), words * 4))
+        return false;
+    }
+    address = tag & 0xffffff;
+  }
+  Number(payload, 0);
+  Emit(17, tick, payload);
+  return !failed;
+}
+
+static CPU::BreakpointCallbackAction OnExecute(CPU::BreakpointType, u32 pc, u32)
+{
+  if (!stream)
+    return CPU::BreakpointCallbackAction::Continue;
+  const u32 tick = Read(profile.game_tick);
+  std::vector<u8> data;
+  if (pc == profile.input_decode)
+  {
+    if (user_mode)
+    {
+      const u32 controller = CPU::g_state.regs.r[4];
+      const u32 pad = controller ? profile.pad_second : profile.pad_first;
+      const u64 clock = ReadClock();
+      for (u32 value : {controller, pad, System::GetFrameNumber(), static_cast<u32>(clock),
+                        static_cast<u32>(clock >> 32), CPU::g_state.regs.r[31]})
+        Number(data, value);
+      failed |= !RAM(data, pad, profile.pad_size);
+      Emit(16, tick, data);
+      input_call_ordinal++;
+    }
+    return CPU::BreakpointCallbackAction::Continue;
+  }
+  if (user_mode && (pc == profile.game_begin || pc == profile.menu_phase || pc == profile.sequence_phase || pc == profile.aux_phase))
+  {
+    const u64 clock = ReadClock();
+    failed |= !CaptureStagePackage(pc, tick, clock);
+    for (u32 value : {pc, System::GetFrameNumber(), static_cast<u32>(clock), static_cast<u32>(clock >> 32),
+                      Read(profile.stage), Read(profile.callback), Read(profile.pad_first), Read(profile.pad_second)})
+      Number(data, value);
+    failed |= !RAM(data, profile.menu_state, profile.menu_state_size) || !RAM(data, profile.actors, profile.actors_size) || !RAM(data, profile.camera, profile.camera_size);
+    Emit(15, tick, data);
+    if (!PhaseGPU(pc, tick))
+    {
+      Close(tick, false);
+      return CPU::BreakpointCallbackAction::Continue;
+    }
+    data.clear();
+  }
+  if (pc == profile.menu_phase || pc == profile.sequence_phase || pc == profile.aux_phase)
+    return CPU::BreakpointCallbackAction::Continue;
+  if (pc == profile.game_begin)
+  {
+    failed |= !Boundary(tick);
+    if ((!user_mode && tick >= end_tick) || failed)
+    {
+      Close(tick, tick == end_tick);
+      return user_mode ? CPU::BreakpointCallbackAction::Continue : CPU::BreakpointCallbackAction::Pause;
+    }
+  }
+  else if (pc == profile.input_inject && CPU::g_state.regs.r[6] == profile.pad_first)
+  {
+    requested = 0;
+    if (user_mode)
+      requested = (Read(profile.pad_first) >> 16) ^ 65535;
+    else
+    {
+      for (size_t offset = 0; offset < schedule.size(); offset += 12)
+        if (tick >= Word(&schedule[offset]) && tick <= Word(&schedule[offset + 4]))
+          requested = Word(&schedule[offset + 8]);
+      failed |= !CPU::SafeWriteMemoryHalfWord(profile.pad_buttons, static_cast<u16>(requested ^ 65535));
+    }
+  }
+  else if (pc == profile.game_input_result)
+  {
+    Number(data, requested);
+    Number(data, Read(profile.decoded_input) & 65535);
+    Emit(3, tick, data);
+  }
+  else if (pc != profile.input_inject)
+  {
+    Number(data, pc);
+    const u32 count = pc == profile.sound_one ? 1 : pc == profile.sound_two ? 2 : 3;
+    for (u32 i = 0; i < count; i++)
+      Number(data, CPU::g_state.regs.r[4 + i]);
+    Emit(4, tick, data);
+  }
+  if (failed)
+  {
+    Close(tick, false);
+    return user_mode ? CPU::BreakpointCallbackAction::Continue : CPU::BreakpointCallbackAction::Pause;
+  }
+  return CPU::BreakpointCallbackAction::Continue;
+}
+
+static void Disarm()
+{
+  if (!armed)
+    return;
+  for (u32 pc : sites)
+    CPU::RemoveBreakpoint(CPU::BreakpointType::Execute, pc);
+  armed = false;
+}
+
+static const char* Start(std::string_view data, bool detailed = false, bool vblank = false, bool states = false, bool user = false)
+{
+  if (!System::IsPaused() || System::IsExecuting() || stream || CPU::HasAnyBreakpoints())
+    return "E20";
+  if (!LoadProfile())
+    return "E25";
+  sites = {profile.game_begin, profile.game_input_result, profile.input_inject, profile.sound_three_a,
+                               profile.sound_three_b, profile.sound_one, profile.sound_two, profile.menu_phase, profile.sequence_phase, profile.input_decode, profile.aux_phase};
+  if (!user && CPU::g_state.pc != profile.game_begin)
+    return "E20";
+  if (user && (g_settings.rewind_enable || g_settings.runahead_frames ||
+               g_settings.cpu_overclock_enable || g_settings.cpu_enable_8mb_ram))
+    return "E24";
+  const size_t comma = data.find(',');
+  if (comma == std::string_view::npos)
+    return "E21";
+  auto name_bytes = StringUtil::DecodeHex(data.substr(0, comma));
+  auto config = StringUtil::DecodeHex(data.substr(comma + 1));
+  const size_t header_size = detailed ? 12 : 4;
+  if (!name_bytes || name_bytes->empty() || name_bytes->size() > 64 || !config ||
+      config->size() < header_size || (config->size() - header_size) % 12 != 0)
+    return "E21";
+  std::string name(name_bytes->begin(), name_bytes->end());
+  if (states && name.size() > 40)
+    return "E21";
+  for (char c : name)
+    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+          (c >= '0' && c <= '9') || c == '-' || c == '_'))
+      return "E21";
+  end_tick = Word(config->data());
+  failed = false;
+  const u32 tick = Read(profile.game_tick);
+  if (failed || (user ? (end_tick == 0 || end_tick > 600 || config->size() != 4) : (end_tick <= tick || end_tick - tick > 18000)))
+    return "E21";
+  detail_from = detailed ? Word(config->data() + 4) : UINT32_MAX;
+  detail_to = detailed ? Word(config->data() + 8) : 0;
+  if (detailed && (detail_from < tick || detail_to < detail_from || detail_to > end_tick || detail_to - detail_from > 120))
+    return "E21";
+  schedule.assign(config->begin() + header_size, config->end());
+  u32 previous = 0;
+  for (size_t offset = 0; offset < schedule.size(); offset += 12)
+  {
+    const u32 begin = Word(&schedule[offset]), end = Word(&schedule[offset + 4]);
+    if (begin > end || (offset && begin <= previous) || Word(&schedule[offset + 8]) > 65535)
+      return "E21";
+    previous = end;
+  }
+  const std::string path = Path::Combine(EmuFolders::SaveStates, "ff-trace-" + name + ".bin");
+  stream = std::fopen(path.c_str(), "wbx");
+  if (!stream)
+    return "E22";
+  std::setvbuf(stream, nullptr, _IOFBF, 1024 * 1024);
+  const u32 magic[] = {user ? 0x32544646u : 0x31544646u, tick, end_tick};
+  failed = std::fwrite(magic, sizeof(magic), 1, stream) != 1;
+  if (!writer.Start(stream))
+  {
+    std::fclose(stream);
+    stream = nullptr;
+    return "E23";
+  }
+  last_boundary = UINT32_MAX;
+  vblank_enabled = vblank;
+  last_vblank = UINT32_MAX;
+  vblank_count = 0;
+  previous_memory.clear();
+  page_contents.clear();
+  previous_page_ids.fill(0);
+  next_page_content = 1;
+  states_enabled = states;
+  trace_name = name;
+  next_state_tick = 0;
+  state_index = 0;
+  user_mode = user;
+  if (user_mode)
+    failed |= !BeginStagePackages(name);
+  last_observed_clock = System::GetGlobalTickCounter();
+  user_end_tick = System::GetGlobalTickCounter() + static_cast<u64>(System::GetTicksPerSecond()) * end_tick;
+  armed = true;
+  for (u32 pc : sites)
+    failed |= !CPU::AddBreakpointWithCallback(CPU::BreakpointType::Execute, pc, OnExecute);
+  if (user_mode)
+  {
+    const u64 now = System::GetGlobalTickCounter();
+    std::vector<u8> metadata;
+    Number(metadata, static_cast<u32>(System::GetTicksPerSecond()));
+    Number(metadata, static_cast<u32>(now));
+    Number(metadata, static_cast<u32>(now >> 32));
+    Number(metadata, System::GetFrameNumber());
+    Emit(12, tick, metadata);
+    initial_settings = EffectiveSettings();
+    Emit(14, tick, std::vector<u8>(initial_settings.begin(), initial_settings.end()));
+  }
+  if (!user_mode)
+    failed |= !Boundary(tick);
+  if (states_enabled && !failed)
+    SaveCheckpoint();
+  if (failed)
+  {
+    Close(tick, false);
+    Disarm();
+    return "E23";
+  }
+  return "OK";
+}
+}
