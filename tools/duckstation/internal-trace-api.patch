+bool GDBServer::Cmd$qXportLockstepRecordRead(ClientSocket* client, std::string_view data)
+{
+  const std::string_view offset_text = TakeLockstepField(&data);
+  const std::string_view count_text = TakeLockstepField(&data);
+  const auto offset = StringUtil::FromChars<u32>(offset_text, 16);
+  const auto count = StringUtil::FromChars<u32>(count_text, 16);
+  if (System::IsExecuting() || !data.empty() || !offset.has_value() ||
+      !count.has_value() || !*count || *count > 64 || *offset > s_locals.lockstep_record_frames.size())
+    return SendLockstepError(client, "record", "invalid_record_read");
+  s_locals.lockstep_frame_active = false;
+  s_locals.lockstep_record_active = false;
+  const u32 total = static_cast<u32>(s_locals.lockstep_record_frames.size());
+  const u32 end = std::min(total, *offset + *count);
+  SmallString reply;
+  reply.append_format("RECORD:{:x}:{:x}:", total, *offset);
+  for (u32 index = *offset; index < end; index++)
+  {
+    const LockstepRecordFrame& frame = s_locals.lockstep_record_frames[index];
+    if (index != *offset)
+      reply.append(';');
+    reply.append_format("{:x},{:x},{:x},{:x},{:x},{:x},{:x}", frame.frame,
+                        frame.pads[0].type, frame.pads[0].buttons, frame.pads[0].analog,
+                        frame.pads[1].type, frame.pads[1].buttons, frame.pads[1].analog);
+  }
+  client->SendReplyWithAck(reply);
+  return true;
+}
