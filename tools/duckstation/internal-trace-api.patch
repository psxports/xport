+bool GDBServer::Cmd$qXportWaitPoints(ClientSocket* client, std::string_view data)
+{
+  if (System::IsExecuting())
+    return SendLockstepError(client, "wait", "not_paused");
+  std::vector<u32> pcs;
+  while (!data.empty())
+  {
+    const auto pc = StringUtil::FromChars<u32>(TakeLockstepField(&data), 16);
+    if (!pc.has_value() || (*pc & 3))
+      return SendLockstepError(client, "wait", "invalid_pc");
+    pcs.push_back(*pc);
+  }
+  TimingEvents::SetWaitPoints(pcs);
+  client->SendReplyWithAck("OK:wait");
+  return true;
+}
