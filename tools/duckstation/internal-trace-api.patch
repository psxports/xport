+  AlreadySeeded,
+  Unseeded,
+  InvalidDeferredState,
+};
+
+struct Range
+{
+  enum class Region
+  {
+    Dram,
+    Scratchpad,
+  } region;
+  u32 offset;
+  u32 size;
+};
+
+struct Difference
+{
+  enum class Region
+  {
+    None,
+    Dram,
+    Scratchpad,
+  } region = Region::None;
+  u32 offset = 0;
+  u32 length = 0;
+  std::array<u8, MAX_DIFF_SIZE> original{};
+  std::array<u8, MAX_DIFF_SIZE> candidate{};
+};
+
+struct DeferredRange
+{
+  u32 region;
+  u32 offset;
+  u32 size;
+};
+
+struct DeferredState
+{
+  u32 magic;
+  u32 version;
+  volatile u32 sequence;
+  volatile u32 generation;
+  volatile u32 range_count;
+  volatile u32 boundary_count;
+  volatile u32 catchup_count;
+  volatile u32 open;
+  volatile u32 resolved;
+  volatile u32 canonical_count;
+  DeferredRange ready;
+  DeferredRange canonical[DEFERRED_MAX_CANONICAL_RANGES];
+  DeferredRange ranges[DEFERRED_MAX_RANGES];
+  volatile u32 device_sequence;
+  volatile u32 device_ticks_low;
+  volatile u32 device_ticks_high;
+  volatile u32 spu_timeline_active;
+  volatile u32 spu_timeline_write;
+  volatile u32 spu_timeline_read;
+  volatile u32 spu_timeline_error;
+  SpuEvent spu_events[SPU_EVENT_CAPACITY];
+};
+
+class Peer final
+{
+public:
+  Peer() = default;
+  ~Peer() { Detach(); }
+
+  Peer(const Peer&) = delete;
+  Peer& operator=(const Peer&) = delete;
+
+  Error Attach(std::string_view run_id, std::string_view dram_name, std::string_view scratchpad_name,
+               std::string_view deferred_name);
+  Error Detach(std::string_view run_id = {});
+  Error SetStackRanges(std::string_view identity, std::span<const Range> ranges);
+  Error Seed(const u8* original_dram, const u8* original_scratchpad, const u8* original_vram);
+  Error Compare(std::string_view stack_identity, const u8* original_dram, const u8* original_scratchpad,
+                Difference* difference, u32* deferred_generation);
+  void PublishDeviceTicks(u64 ticks);
+  void ResetSpuTimeline();
+  void PublishSpuEvent(SpuEventKind kind, u32 address, u32 value, u64 ticks);
+
+  bool IsAttached() const
+  {
+    return m_candidate_dram != nullptr && m_candidate_scratchpad != nullptr && m_candidate_vram != nullptr &&
+           m_deferred != nullptr;
+  }
+  bool IsSeeded() const { return m_seeded; }
+  std::string_view GetRunId() const { return m_run_id; }
+
+private:
+  static bool IsRunId(std::string_view value);
+  static std::string MappingName(std::string_view run_id, std::string_view region);
+  static void FindDifference(Difference::Region region, u32 base, const u8* original, const u8* candidate,
+                             u32 size, Difference* difference);
+
+#ifdef _WIN32
+  static Error OpenMapping(std::string_view name, u32 size, HANDLE* handle, const u8** view, bool writable = false);
+  HANDLE m_dram_handle = nullptr;
+  HANDLE m_scratchpad_handle = nullptr;
+  HANDLE m_vram_handle = nullptr;
+  HANDLE m_deferred_handle = nullptr;
+#endif
+  const u8* m_candidate_dram = nullptr;
+  const u8* m_candidate_scratchpad = nullptr;
+  const u8* m_candidate_vram = nullptr;
+  DeferredState* m_deferred = nullptr;
+  std::string m_run_id;
+  std::string m_dram_name;
+  std::string m_scratchpad_name;
+  std::string m_vram_name;
+  std::string m_deferred_name;
+  std::string m_stack_identity;
+  std::vector<Range> m_stack_ranges;
+  bool m_seeded = false;
+  u32 m_resolved_deferred_generation = 0;
+  u32 m_active_deferred_generation = 0;
+  u32 m_deferred_boundaries_seen = 0;
+  u32 m_deferred_boundaries_remaining = 0;
+  u32 m_deferred_catchup = 0;
+  bool m_deferred_closed = false;
+  bool m_deferred_ready_published = false;
+  u32 m_deferred_canonical_count = 0;
+  std::array<DeferredRange, DEFERRED_MAX_CANONICAL_RANGES> m_deferred_canonical{};
+};
+
+inline void Peer::PublishDeviceTicks(u64 ticks)
+{
+#ifdef _WIN32
+  if (!m_deferred)
+    return;
+  InterlockedIncrement(reinterpret_cast<volatile LONG*>(&m_deferred->device_sequence));
+  MemoryBarrier();
+  m_deferred->device_ticks_low = static_cast<u32>(ticks);
+  m_deferred->device_ticks_high = static_cast<u32>(ticks >> 32);
+  MemoryBarrier();
+  InterlockedIncrement(reinterpret_cast<volatile LONG*>(&m_deferred->device_sequence));
+#else
+  (void)ticks;
+#endif
+}
+
+inline void Peer::ResetSpuTimeline()
+{
+#ifdef _WIN32
+  if (!m_deferred)
+    return;
+  m_deferred->spu_timeline_active = 0u;
+  MemoryBarrier();
+  m_deferred->spu_timeline_write = 0u;
+  m_deferred->spu_timeline_read = 0u;
+  m_deferred->spu_timeline_error = 0u;
+  MemoryBarrier();
+  m_deferred->spu_timeline_active = 1u;
+#endif
+}
+
+inline void Peer::PublishSpuEvent(SpuEventKind kind, u32 address, u32 value, u64 ticks)
+{
+#ifdef _WIN32
+  if (!m_deferred || !m_deferred->spu_timeline_active || m_deferred->spu_timeline_error)
+    return;
+  const u32 write = m_deferred->spu_timeline_write;
+  const u32 read = m_deferred->spu_timeline_read;
+  if (write - read >= SPU_EVENT_CAPACITY)
+  {
+    InterlockedCompareExchange(reinterpret_cast<volatile LONG*>(&m_deferred->spu_timeline_error), 1, 0);
+    return;
+  }
+  SpuEvent& event = m_deferred->spu_events[write % SPU_EVENT_CAPACITY];
+  event.kind = static_cast<u32>(kind);
+  event.address = address;
+  event.value = value;
+  event.ticks_low = static_cast<u32>(ticks);
+  event.ticks_high = static_cast<u32>(ticks >> 32);
+  MemoryBarrier();
+  InterlockedExchange(reinterpret_cast<volatile LONG*>(&m_deferred->spu_timeline_write),
+                      static_cast<LONG>(write + 1u));
+#else
+  (void)kind;
+  (void)address;
+  (void)value;
+  (void)ticks;
+#endif
+}
+
+inline bool Peer::IsRunId(std::string_view value)
+{
+  if (value.size() != 32)
+    return false;
+  for (const char character : value)
+  {
+    if (!((character >= '0' && character <= '9') || (character >= 'a' && character <= 'f')))
+      return false;
+  }
+  return true;
+}
+
+inline std::string Peer::MappingName(std::string_view run_id, std::string_view region)
+{
+  std::string value = "Local\\xport-lockstep-";
+  value.append(run_id);
+  value.push_back('-');
+  value.append(region);
+  return value;
+}
+
+#ifdef _WIN32
+inline Error Peer::OpenMapping(std::string_view name, u32 size, HANDLE* handle, const u8** view, bool writable)
+{
+  using NtQuerySectionProc = LONG(NTAPI*)(HANDLE, u32, void*, u32, u32*);
+  struct SectionBasicInformation
+  {
+    void* base_address;
+    u32 allocation_attributes;
+    LARGE_INTEGER maximum_size;
+  };
+
+  const std::string terminated_name(name);
+  static constexpr DWORD SECTION_QUERY_ACCESS = 0x0001u;
+  const DWORD mapping_access = FILE_MAP_READ | (writable ? FILE_MAP_WRITE : 0u);
+  *handle = OpenFileMappingA(mapping_access | SECTION_QUERY_ACCESS, FALSE, terminated_name.c_str());
+  if (!*handle)
+    return Error::OpenFailed;
+  const HMODULE ntdll = GetModuleHandleW(L"ntdll.dll");
+  const auto query = ntdll ? reinterpret_cast<NtQuerySectionProc>(GetProcAddress(ntdll, "NtQuerySection")) : nullptr;
+  SectionBasicInformation information{};
+  SYSTEM_INFO system_information{};
+  GetSystemInfo(&system_information);
+  u32 returned = 0;
+  if (!query || query(*handle, 0, &information, sizeof(information), &returned) < 0 ||
+      information.maximum_size.QuadPart < size ||
+      static_cast<u64>(information.maximum_size.QuadPart - size) >= system_information.dwPageSize ||
+      ((size % system_information.dwPageSize) == 0 && information.maximum_size.QuadPart != size))
+  {
+    CloseHandle(*handle);
+    *handle = nullptr;
+    return Error::SizeMismatch;
+  }
+  *view = static_cast<const u8*>(MapViewOfFile(*handle, mapping_access, 0, 0, size));
+  if (!*view)
+  {
+    CloseHandle(*handle);
+    *handle = nullptr;
+    return Error::MapFailed;
+  }
+  return Error::None;
+}
+#endif
+
+inline Error Peer::Attach(std::string_view run_id, std::string_view dram_name,
+                          std::string_view scratchpad_name, std::string_view deferred_name)
+{
+#ifndef _WIN32
+  return Error::PlatformUnsupported;
+#else
+  if (!IsRunId(run_id) || dram_name != MappingName(run_id, "dram") ||
+      scratchpad_name != MappingName(run_id, "scratchpad") ||
+      deferred_name != MappingName(run_id, "deferred"))
+    return Error::InvalidIdentity;
+  if (IsAttached())
+  {
+    return m_run_id == run_id && m_dram_name == dram_name && m_scratchpad_name == scratchpad_name &&
+                   m_deferred_name == deferred_name ?
+             Error::None : Error::AlreadyAttached;
+  }
+  Error error = OpenMapping(dram_name, DRAM_SIZE, &m_dram_handle, &m_candidate_dram, true);
+  if (error != Error::None)
+    return error;
+  error = OpenMapping(scratchpad_name, SCRATCHPAD_SIZE, &m_scratchpad_handle, &m_candidate_scratchpad, true);
+  if (error != Error::None)
+  {
+    UnmapViewOfFile(m_candidate_dram);
+    CloseHandle(m_dram_handle);
+    m_candidate_dram = nullptr;
+    m_dram_handle = nullptr;
+    return error;
+  }
+  const std::string vram_name = MappingName(run_id, "vram");
+  error = OpenMapping(vram_name, VRAM_SIZE, &m_vram_handle, &m_candidate_vram, true);
+  if (error != Error::None)
+  {
+    UnmapViewOfFile(m_candidate_scratchpad);
+    UnmapViewOfFile(m_candidate_dram);
+    CloseHandle(m_scratchpad_handle);
+    CloseHandle(m_dram_handle);
+    m_candidate_scratchpad = nullptr;
+    m_candidate_dram = nullptr;
+    m_scratchpad_handle = nullptr;
+    m_dram_handle = nullptr;
+    return error;
+  }
+  const u8* deferred_view = nullptr;
+  error = OpenMapping(deferred_name, sizeof(DeferredState), &m_deferred_handle, &deferred_view, true);
+  if (error != Error::None)
+  {
+    UnmapViewOfFile(m_candidate_vram);
+    UnmapViewOfFile(m_candidate_scratchpad);
+    UnmapViewOfFile(m_candidate_dram);
+    CloseHandle(m_vram_handle);
+    CloseHandle(m_scratchpad_handle);
+    CloseHandle(m_dram_handle);
+    m_candidate_vram = nullptr;
+    m_candidate_scratchpad = nullptr;
+    m_candidate_dram = nullptr;
+    m_vram_handle = nullptr;
+    m_scratchpad_handle = nullptr;
+    m_dram_handle = nullptr;
+    return error;
+  }
+  m_deferred = const_cast<DeferredState*>(reinterpret_cast<const DeferredState*>(deferred_view));
+  if (m_deferred->magic != DEFERRED_MAGIC || m_deferred->version != DEFERRED_VERSION)
+  {
+    UnmapViewOfFile(m_deferred);
+    CloseHandle(m_deferred_handle);
+    m_deferred = nullptr;
+    m_deferred_handle = nullptr;
+    UnmapViewOfFile(m_candidate_vram);
+    UnmapViewOfFile(m_candidate_scratchpad);
+    UnmapViewOfFile(m_candidate_dram);
+    CloseHandle(m_vram_handle);
+    CloseHandle(m_scratchpad_handle);
+    CloseHandle(m_dram_handle);
+    m_candidate_vram = nullptr;
+    m_candidate_scratchpad = nullptr;
+    m_candidate_dram = nullptr;
+    m_vram_handle = nullptr;
+    m_scratchpad_handle = nullptr;
+    m_dram_handle = nullptr;
+    return Error::InvalidDeferredState;
+  }
+  m_run_id = run_id;
+  m_dram_name = dram_name;
+  m_scratchpad_name = scratchpad_name;
+  m_vram_name = vram_name;
+  m_deferred_name = deferred_name;
+  return Error::None;
+#endif
+}
+
+inline Error Peer::Detach(std::string_view run_id)
+{
+  if (!IsAttached())
+    return Error::None;
+  if (!run_id.empty() && run_id != m_run_id)
+    return Error::InvalidIdentity;
+#ifdef _WIN32
+  UnmapViewOfFile(m_deferred);
+  UnmapViewOfFile(m_candidate_vram);
+  UnmapViewOfFile(m_candidate_scratchpad);
+  UnmapViewOfFile(m_candidate_dram);
+  CloseHandle(m_deferred_handle);
+  CloseHandle(m_vram_handle);
+  CloseHandle(m_scratchpad_handle);
+  CloseHandle(m_dram_handle);
+  m_deferred_handle = nullptr;
+  m_vram_handle = nullptr;
+  m_scratchpad_handle = nullptr;
+  m_dram_handle = nullptr;
+#endif
+  m_deferred = nullptr;
+  m_candidate_scratchpad = nullptr;
+  m_candidate_vram = nullptr;
+  m_candidate_dram = nullptr;
+  m_run_id.clear();
+  m_dram_name.clear();
+  m_scratchpad_name.clear();
+  m_vram_name.clear();
+  m_deferred_name.clear();
+  m_stack_identity.clear();
+  m_stack_ranges.clear();
+  m_seeded = false;
+  m_resolved_deferred_generation = 0;
+  m_active_deferred_generation = 0;
+  m_deferred_boundaries_seen = 0;
+  m_deferred_boundaries_remaining = 0;
+  m_deferred_catchup = 0;
+  m_deferred_closed = false;
+  m_deferred_ready_published = false;
+  m_deferred_canonical_count = 0;
+  m_deferred_canonical = {};
+  return Error::None;
+}
+
+inline Error Peer::SetStackRanges(std::string_view identity, std::span<const Range> ranges)
+{
+  if (!IsAttached() || identity.empty() || ranges.empty())
+    return Error::InvalidStackRanges;
+  Range::Region prior_region = ranges.front().region;
+  u32 prior_end = 0;
+  for (const Range& range : ranges)
+  {
+    const u32 region_size = range.region == Range::Region::Dram ? DRAM_SIZE : SCRATCHPAD_SIZE;
+    if (range.region < prior_region)
+      return Error::InvalidStackRanges;
+    if (range.region != prior_region)
+    {
+      prior_region = range.region;
+      prior_end = 0;
+    }
+    if (!range.size || range.offset > region_size - range.size || range.offset < prior_end)
+      return Error::InvalidStackRanges;
+    prior_end = range.offset + range.size;
+  }
+  m_stack_identity = identity;
+  m_stack_ranges.assign(ranges.begin(), ranges.end());
+  return Error::None;
+}
+
+inline Error Peer::Seed(const u8* original_dram, const u8* original_scratchpad, const u8* original_vram)
+{
+#ifndef _WIN32
+  return Error::PlatformUnsupported;
+#else
+  if (!IsAttached() || !original_dram || !original_scratchpad || !original_vram)
+    return Error::NotAttached;
+  if (m_seeded)
+    return Error::AlreadySeeded;
+  const auto copy_mapping = [](const std::string& name, const u8* source, u32 size) {
+    HANDLE handle = OpenFileMappingA(FILE_MAP_WRITE, FALSE, name.c_str());
+    if (!handle)
+      return false;
+    void* view = MapViewOfFile(handle, FILE_MAP_WRITE, 0, 0, size);
+    if (view)
+    {
+      std::memcpy(view, source, size);
+      FlushViewOfFile(view, size);
+      UnmapViewOfFile(view);
+    }
+    CloseHandle(handle);
+    return view != nullptr;
+  };
+  if (!copy_mapping(m_dram_name, original_dram, DRAM_SIZE) ||
+      !copy_mapping(m_scratchpad_name, original_scratchpad, SCRATCHPAD_SIZE) ||
+      !copy_mapping(m_vram_name, original_vram, VRAM_SIZE))
+    return Error::MapFailed;
+  m_seeded = true;
+  return Error::None;
+#endif
+}
+
+inline void Peer::FindDifference(Difference::Region region, u32 base, const u8* original, const u8* candidate,
+                                 u32 size, Difference* difference)
+{
+  if (size == 0 || std::memcmp(original, candidate, size) == 0)
+    return;
+  u32 offset = 0;
+  while (original[offset] == candidate[offset])
+    offset++;
+  difference->region = region;
+  difference->offset = base + offset;
+  while (offset + difference->length < size && difference->length < MAX_DIFF_SIZE &&
+         original[offset + difference->length] != candidate[offset + difference->length])
+  {
+    difference->original[difference->length] = original[offset + difference->length];
+    difference->candidate[difference->length] = candidate[offset + difference->length];
+    difference->length++;
+  }
+}
+
+inline Error Peer::Compare(std::string_view stack_identity, const u8* original_dram,
+                           const u8* original_scratchpad, Difference* difference,
+                           u32* deferred_generation)
+{
+  if (!IsAttached())
+    return Error::NotAttached;
+  if (!m_seeded)
+    return Error::Unseeded;
+  if (stack_identity != m_stack_identity || m_stack_ranges.empty())
+    return Error::UnknownStackRanges;
+  if (!deferred_generation)
+    return Error::InvalidDeferredState;
+  *difference = {};
+  *deferred_generation = 0;
+  DeferredState snapshot{};
+  for (u32 attempt = 0; attempt < 4; attempt++)
+  {
+    const u32 before = m_deferred->sequence;
+    if (before & 1u)
+      continue;
+    std::memcpy(&snapshot, m_deferred, sizeof(snapshot));
+#ifdef _WIN32
+    MemoryBarrier();
+#endif
+    if (before == m_deferred->sequence && !(before & 1u))
+      break;
+    snapshot.magic = 0;
+  }
+  if (snapshot.magic != DEFERRED_MAGIC || snapshot.version != DEFERRED_VERSION ||
+      snapshot.range_count > DEFERRED_MAX_RANGES ||
+      snapshot.canonical_count > DEFERRED_MAX_CANONICAL_RANGES ||
+      snapshot.open > 1u || snapshot.resolved > 1u ||
+      snapshot.spu_timeline_active > 1u || snapshot.spu_timeline_error ||
+      snapshot.spu_timeline_read != snapshot.spu_timeline_write)
+    return Error::InvalidDeferredState;
+  if (m_deferred_ready_published)
+  {
+    for (u32 index = 0; index < m_deferred_canonical_count; index++)
+    {
+      const DeferredRange& canonical = m_deferred_canonical[index];
+      const u8* original = canonical.region == 1u ? original_dram : original_scratchpad;
+      u8* candidate = const_cast<u8*>(canonical.region == 1u ? m_candidate_dram : m_candidate_scratchpad);
+      std::memcpy(candidate + canonical.offset, original + canonical.offset, canonical.size);
+    }
+    m_resolved_deferred_generation = m_active_deferred_generation;
+    m_active_deferred_generation = 0;
+    m_deferred_ready_published = false;
+    m_deferred_canonical_count = 0;
+  }
+  if (snapshot.generation && snapshot.generation != m_resolved_deferred_generation)
+  {
+    if (snapshot.generation != m_active_deferred_generation)
+    {
+      m_active_deferred_generation = snapshot.generation;
+      m_deferred_boundaries_seen = 0;
+      m_deferred_boundaries_remaining = 0;
+      m_deferred_catchup = 0;
+      m_deferred_closed = false;
+      m_deferred_ready_published = false;
+      m_deferred_canonical_count = 0;
+    }
+    if (snapshot.open)
+    {
+      if (m_deferred_closed)
+        return Error::InvalidDeferredState;
+      m_deferred_boundaries_seen++;
+      *deferred_generation = snapshot.generation;
+      return Error::None;
+    }
+    if (!m_deferred_closed)
+    {
+      if (!snapshot.range_count || m_deferred_boundaries_seen > snapshot.boundary_count)
+        return Error::InvalidDeferredState;
+      for (u32 index = 0; index < snapshot.range_count; index++)
+      {
+        const DeferredRange& source = snapshot.ranges[index];
+        const Range::Region region = source.region == 1u ? Range::Region::Dram :
+                                     source.region == 2u ? Range::Region::Scratchpad :
+                                                           static_cast<Range::Region>(2);
+        const u32 limit = region == Range::Region::Dram ? DRAM_SIZE : SCRATCHPAD_SIZE;
+        if ((source.region != 1u && source.region != 2u) || !source.size ||
+            source.offset > limit - source.size)
+          return Error::InvalidDeferredState;
+      }
+      const u32 ready_limit = snapshot.ready.region == 1u ? DRAM_SIZE :
+                              snapshot.ready.region == 2u ? SCRATCHPAD_SIZE : 0u;
+      if (!ready_limit || !snapshot.ready.size ||
+          snapshot.ready.offset > ready_limit - snapshot.ready.size)
+        return Error::InvalidDeferredState;
+      if (!snapshot.canonical_count)
+        return Error::InvalidDeferredState;
+      for (u32 index = 0; index < snapshot.canonical_count; index++)
+      {
+        const DeferredRange& canonical = snapshot.canonical[index];
+        const u32 canonical_limit = canonical.region == 1u ? DRAM_SIZE :
+                                    canonical.region == 2u ? SCRATCHPAD_SIZE : 0u;
+        if (!canonical_limit || !canonical.size || canonical.offset > canonical_limit - canonical.size)
+          return Error::InvalidDeferredState;
+      }
+      m_deferred_boundaries_remaining = snapshot.boundary_count - m_deferred_boundaries_seen;
+      m_deferred_catchup = m_deferred_boundaries_remaining;
+      m_deferred_closed = true;
+    }
+    if (m_deferred_boundaries_remaining)
+    {
+      m_deferred_boundaries_remaining--;
+      *deferred_generation = snapshot.generation;
+      return Error::None;
+    }
+    const u8* ready_original = snapshot.ready.region == 1u ? original_dram : original_scratchpad;
+    const u8* ready_candidate = snapshot.ready.region == 1u ? m_candidate_dram : m_candidate_scratchpad;
+    if (std::memcmp(ready_original + snapshot.ready.offset, ready_candidate + snapshot.ready.offset,
+                    snapshot.ready.size) != 0)
+    {
+      if (m_deferred_catchup == 0xffffffffu)
+        return Error::InvalidDeferredState;
+      m_deferred_catchup++;
+      *deferred_generation = snapshot.generation;
+      return Error::None;
+    }
+    if (!m_deferred_ready_published)
+    {
+      for (u32 index = 0; index < snapshot.canonical_count; index++)
+      {
+        const DeferredRange& canonical = snapshot.canonical[index];
+        const u8* original = canonical.region == 1u ? original_dram : original_scratchpad;
+        u8* candidate = const_cast<u8*>(canonical.region == 1u ? m_candidate_dram : m_candidate_scratchpad);
+        std::memcpy(candidate + canonical.offset, original + canonical.offset, canonical.size);
+        m_deferred_canonical[index] = canonical;
+      }
+      m_deferred_canonical_count = snapshot.canonical_count;
+#ifdef _WIN32
+      InterlockedIncrement(reinterpret_cast<volatile LONG*>(&m_deferred->sequence));
+#endif
+      m_deferred->catchup_count = m_deferred_catchup;
+      m_deferred->resolved = 1u;
+#ifdef _WIN32
+      MemoryBarrier();
+      InterlockedIncrement(reinterpret_cast<volatile LONG*>(&m_deferred->sequence));
+#endif
+      m_deferred_ready_published = true;
+      *deferred_generation = snapshot.generation;
+      return Error::None;
+    }
+  }
+  std::vector<Range> compare_ranges = m_stack_ranges;
+  const auto compare_region = [difference](const std::vector<Range>& ranges, Range::Region range_region,
+                                            Difference::Region difference_region, const u8* original,
+                                            const u8* candidate, u32 size) {
+    u32 begin = 0;
+    for (const Range& range : ranges)
+    {
+      if (range.region != range_region)
+        continue;
+      FindDifference(difference_region, begin, original + begin, candidate + begin, range.offset - begin, difference);
+      if (difference->region != Difference::Region::None)
+        return;
+      begin = range.offset + range.size;
+    }
+    FindDifference(difference_region, begin, original + begin, candidate + begin, size - begin, difference);
+  };
+  compare_region(compare_ranges, Range::Region::Dram, Difference::Region::Dram,
+                 original_dram, m_candidate_dram, DRAM_SIZE);
+  if (difference->region == Difference::Region::None)
+    compare_region(compare_ranges, Range::Region::Scratchpad, Difference::Region::Scratchpad, original_scratchpad,
+                   m_candidate_scratchpad, SCRATCHPAD_SIZE);
+  if (difference->region == Difference::Region::None)
+    return Error::None;
+  return Error::None;
+}
