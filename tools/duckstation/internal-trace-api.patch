+bool GDBServer::Cmd$qXportLockstepHandoffState(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || System::IsExecuting() || !System::IsPaused() ||
+      !s_locals.lockstep_replay_active || s_locals.lockstep_boundary_active)
+    return SendLockstepError(client, "handoff_state", "handoff_state_not_ready");
+  const u32 timer1 = Timers::ReadRegister(0x10);
+  const u32 gpu_status = GPU::ReadRegister(0x04);
+  const u32 field_lines = GPU::IsInPALMode() ? 314u : 263u;
+  client->SendReplyWithAck(TinyString::from_format(
+    "HANDOFF:{:08x}:{:08x}:{:x}", timer1, gpu_status, field_lines));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepTimerState(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || System::IsExecuting() || !System::IsPaused() || !s_locals.lockstep_replay_active)
+    return SendLockstepError(client, "timer_state", "replay_not_paused");
+  std::array<u8, 64> bytes{};
+  StateWrapper sw(std::span<u8>(bytes), StateWrapper::Mode::Write, SAVE_STATE_VERSION);
+  if (!Timers::DoState(sw) || sw.GetPosition() != 59)
+    return SendLockstepError(client, "timer_state", "serializer_contract_changed");
+  client->SendReplyWithAck(SmallString::from_format(
+    "TIMERSTATE:{:x}:{:x}:{:x}:{}", SAVE_STATE_VERSION,
+    TimingEvents::GetGlobalTickCounter(),
+    Timers::GetPendingSysClkTicks(), StringUtil::EncodeHex(bytes.data(), sw.GetPosition())));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepBeamState(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || System::IsExecuting() || !System::IsPaused() || !s_locals.lockstep_replay_active)
+    return SendLockstepError(client, "beam_state", "replay_not_paused");
+  u32 tick, line;
+  GPU::GetBeamPosition(&tick, &line);
+  std::array<u8, 12> bytes{};
+  StateWrapper sw(std::span<u8>(bytes), StateWrapper::Mode::Write, SAVE_STATE_VERSION);
+  if (!InterruptController::DoState(sw) || sw.GetPosition() != bytes.size())
+    return SendLockstepError(client, "beam_state", "irq_serializer_contract_changed");
+  client->SendReplyWithAck(SmallString::from_format(
+    "BEAMSTATE:{:x}:{:x}:{:x}:{:x}:{:x}:{:x}:{}",
+    TimingEvents::GetGlobalTickCounter(), GPU::GetCRTCFrequency(), tick, line,
+    GPU::GetCRTCActiveStartLine(), GPU::GetCRTCActiveEndLine(),
+    StringUtil::EncodeHex(bytes.data(), bytes.size())));
+  return true;
+}
