+bool GDBServer::Cmd$qXportFunctionCoverageStart(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || System::IsExecuting() || !System::IsPaused() ||
+      s_locals.lockstep_peer.IsAttached() || s_locals.lockstep_boundary_active ||
+      s_locals.lockstep_frame_active || s_locals.lockstep_replay_active ||
+      s_locals.lockstep_record_active || s_locals.function_coverage_active)
+  {
+    return SendLockstepError(client, "coverage", "coverage_not_isolated");
+  }
+  s_locals.lockstep_event = {};
+  s_locals.lockstep_event_pending = false;
+  s_locals.function_coverage.Reset();
+  s_locals.function_coverage_active = true;
+  s_locals.lockstep_boundary_active = true;
+  s_locals.resume_on_last_disconnect = true;
+  CPU::UpdateDebugDispatcherFlag();
+  client->SendReplyWithAck("OK:coverage");
+  return true;
+}
