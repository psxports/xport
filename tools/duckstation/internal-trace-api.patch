+bool GDBServer::Cmd$qXportSpuRAMRead(ClientSocket* client, std::string_view data)
+{
+  const auto offset = StringUtil::FromChars<u32>(TakeLockstepField(&data), 16);
+  const auto count = StringUtil::FromChars<u32>(TakeLockstepField(&data), 16);
+  if (!System::IsPaused() || System::IsExecuting() || !data.empty() || !offset.has_value() ||
+      !count.has_value() || !*count || *count > 4096 || *offset > SPU::RAM_SIZE ||
+      *count > SPU::RAM_SIZE - *offset)
+    return SendLockstepError(client, "spu", "invalid_read");
+  const auto& ram = SPU::GetRAM();
+  client->SendReplyWithAck(StringUtil::EncodeHex(ram.data() + *offset, *count));
+  return true;
+}
