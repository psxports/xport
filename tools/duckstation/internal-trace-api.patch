+// Coherent stage entry snapshots with asynchronous file writes
+static FFTraceWriter stage_writer;
+static bool stage_packages_enabled = false;
+static u32 stage_entry_tick = 0, phase_ordinal = 0, input_call_ordinal = 0;
+static u32 prior_phase_pc = UINT32_MAX, prior_phase_stage = UINT32_MAX, prior_phase_tick = UINT32_MAX;
+
+static bool BeginStagePackages(const std::string& name)
+{
+  phase_ordinal = input_call_ordinal = 0;
+  prior_phase_pc = prior_phase_stage = prior_phase_tick = UINT32_MAX;
+  INISettingsInterface ini(Path::Combine(EmuFolders::DataRoot, "xport-trace-profile.ini"));
+  if (!ini.Load())
+    return false;
+  stage_packages_enabled = ini.GetBoolValue("XportStage", "enabled", false);
+  stage_entry_tick = ini.GetUIntValue("XportStage", "entry_tick", 0);
+  if (!stage_packages_enabled)
+    return true;
+  if (!ini.ContainsValue("XportStage", "entry_tick"))
+    return false;
+  const std::string path = Path::Combine(EmuFolders::SaveStates, "ff-stage-" + name + ".bin");
+  FILE* file = std::fopen(path.c_str(), "wbx");
+  if (!file)
+    return false;
+  if (!stage_writer.Start(file))
+  {
+    std::fclose(file);
+    return false;
+  }
+  std::vector<u8> header;
+  for (u32 value : {0x31545358u, 1u, SAVE_STATE_VERSION})
+    Number(header, value);
+  return stage_writer.Write(std::move(header));
+}
+
+static bool StageDevice(std::vector<u8>& payload, u32 kind, bool (*save)(StateWrapper&))
+{
+  std::vector<u8> block(16 * 1024 * 1024);
+  StateWrapper wrapper(std::span<u8>(block), StateWrapper::Mode::Write, SAVE_STATE_VERSION);
+  if (!save(wrapper) || wrapper.HasError())
+    return false;
+  Number(payload, kind);
+  Number(payload, static_cast<u32>(wrapper.GetPosition()));
+  payload.insert(payload.end(), block.begin(), block.begin() + wrapper.GetPosition());
+  return true;
+}
+
+static bool CaptureStagePackage(u32 pc, u32 tick, u64 clock)
+{
+  const u32 stage = Read(profile.stage);
+  const bool capture = stage_packages_enabled && pc == profile.game_begin && tick == stage_entry_tick &&
+    (prior_phase_pc != pc || prior_phase_stage != stage || prior_phase_tick != tick);
+  prior_phase_pc = pc;
+  prior_phase_stage = stage;
+  prior_phase_tick = tick;
+  const u32 ordinal = phase_ordinal++;
+  if (!capture)
+    return true;
+  std::vector<u8> payload;
+  for (u32 value : {ordinal, pc, tick, stage, System::GetFrameNumber(), static_cast<u32>(clock),
+                    static_cast<u32>(clock >> 32), input_call_ordinal, 5u})
+    Number(payload, value);
+  Number(payload, 1); Number(payload, 0x200000);
+  if (!RAM(payload, 0x80000000, 0x200000))
+    return false;
+  Number(payload, 2); Number(payload, 1024);
+  if (!RAM(payload, 0x1f800000, 1024) || !StageDevice(payload, 3, CPU::DoState) ||
+      !StageDevice(payload, 4, GPU::DoState) || !StageDevice(payload, 5, SPU::DoState))
+    return false;
+  std::vector<u8> record;
+  Number(record, 1);
+  Number(record, static_cast<u32>(payload.size()));
+  record.insert(record.end(), payload.begin(), payload.end());
+  return stage_writer.Write(std::move(record));
+}
+
+static bool FinishStagePackages(bool complete)
+{
+  if (!stage_packages_enabled)
+    return true;
+  std::vector<u8> footer;
+  Number(footer, 2); Number(footer, 4); Number(footer, complete ? 1 : 0);
+  const bool queued = stage_writer.Write(std::move(footer));
+  const bool saved = stage_writer.Finish();
+  stage_packages_enabled = false;
+  return queued && saved;
+}
