+  {
+    Error::SetStringView(error, "System is not stopped for checkpoint restore.");
+    return false;
+  }
+
+  StateWrapper sw(data, StateWrapper::Mode::Read, SAVE_STATE_VERSION);
+  if (!DoState(sw, false) || sw.HasError() || sw.GetPosition() != data.size())
+  {
+    Error::SetStringView(error, "Checkpoint state data is invalid.");
+    return false;
+  }
+
+  InterruptExecution();
+  PerformanceCounters::Reset();
+  ResetThrottler();
+  return true;
+}
