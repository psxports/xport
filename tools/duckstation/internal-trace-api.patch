+bool GDBServer::Cmd$qXportLockstepSeed(ClientSocket* client, std::string_view data)
+{
+  if (!System::IsPaused() || System::IsExecuting() || !s_locals.lockstep_replay_active ||
+      data != s_locals.lockstep_record_identity || s_locals.lockstep_boundary_active)
+    return SendLockstepError(client, data, "seed_not_ready");
+  GPU::SynchronizeVRAMForLockstep();
+  const XportLockstep::Error error = s_locals.lockstep_peer.Seed(
+    g_bus.ram, CPU::g_state.scratchpad.data(), reinterpret_cast<const u8*>(g_vram));
+  if (error != XportLockstep::Error::None)
+    return SendLockstepError(client, data, LockstepErrorName(error));
+  s_locals.lockstep_peer.PublishDeviceTicks(SPU::GetXportSampleCounter());
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", data));
+  return true;
+}
+
+static bool ParseLockstepPad(std::string_view value, GDBServer::LockstepPadState* state)
+{
+  const size_t first = value.find(',');
+  const size_t second = first == std::string_view::npos ? first : value.find(',', first + 1);
+  const auto type = first == std::string_view::npos ? std::nullopt :
+    StringUtil::FromChars<u32>(value.substr(0, first), 16);
+  const auto buttons = second == std::string_view::npos ? std::nullopt :
+    StringUtil::FromChars<u32>(value.substr(first + 1, second - first - 1), 16);
+  const auto analog = second == std::string_view::npos ? std::nullopt :
+    StringUtil::FromChars<u32>(value.substr(second + 1), 16);
+  if (!type.has_value() || !buttons.has_value() || !analog.has_value() || *type > 2 || *buttons > 0xffffu)
+    return false;
+  *state = {*type, *buttons, *analog};
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepInput(ClientSocket* client, std::string_view data)
+{
+  const std::string_view frame_text = TakeLockstepField(&data);
+  const std::string_view port0 = TakeLockstepField(&data);
+  const std::string_view port1 = TakeLockstepField(&data);
+  const auto frame = StringUtil::FromChars<u32>(frame_text, 16);
+  std::array<GDBServer::LockstepPadState, 2> states;
+  if (!s_locals.lockstep_replay_active || s_locals.lockstep_input_queued || !data.empty() ||
+      !frame.has_value() || !ParseLockstepPad(port0, &states[0]) || !ParseLockstepPad(port1, &states[1]))
+    return SendLockstepError(client, frame_text, "invalid_frame_input");
+  s_locals.lockstep_queued_frame = *frame;
+  s_locals.lockstep_queued_pad_state = states;
+  s_locals.lockstep_input_queued = true;
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", frame_text));
+  return true;
+}
