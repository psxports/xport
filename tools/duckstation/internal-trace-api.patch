+bool GDBServer::IsLockstepBoundaryActive()
+{
+  return s_locals.lockstep_boundary_active;
+}
+
+bool GDBServer::OnLockstepBeforeInstruction(u32 pc, u32 word, const u32* registers, u32 hi, u32 lo,
+                                            const u32* gte_registers,
+                                            bool prior_branch_taken)
+{
+  if (!s_locals.lockstep_boundary_active || s_locals.lockstep_event_pending)
+    return s_locals.lockstep_event_pending;
+  if (s_locals.function_coverage_active)
+  {
+    s_locals.function_coverage.BeforeInstruction(pc);
+    return false;
+  }
+  if (s_locals.lockstep_transition_pending)
+  {
+    s_locals.lockstep_transition_pending = false;
+    s_locals.lockstep_prefix_guard = false;
+    System::SetFastForwardEnabled(true);
+    s_locals.lockstep_epoch++;
+    s_locals.lockstep_tracker.ResetEpoch();
+    s_locals.lockstep_event_pending = s_locals.lockstep_tracker.ModeTransition(
+      s_locals.lockstep_target_frame, &s_locals.lockstep_event);
+    if (s_locals.lockstep_event_pending)
+      System::PauseSystem(true);
+    return s_locals.lockstep_event_pending;
+  }
+  if (s_locals.lockstep_prefix_guard)
+    return false;
+  s_locals.lockstep_event_pending = s_locals.lockstep_tracker.BeforeInstruction(
+    pc, word, registers, hi, lo, gte_registers, prior_branch_taken, &s_locals.lockstep_event);
+  if (s_locals.lockstep_event_pending)
+    s_locals.lockstep_event.frame = s_locals.lockstep_frame;
+  return s_locals.lockstep_event_pending;
+}
+
+void GDBServer::OnLockstepException(u32 vector, u32 return_pc)
+{
+  if (s_locals.lockstep_boundary_active && !s_locals.function_coverage_active)
+    s_locals.lockstep_tracker.EnterException(vector, return_pc);
+}
+
+static bool CaptureLockstepPads(std::array<GDBServer::LockstepPadState, 2>* states, std::string* error)
+{
+  for (u32 port = 0; port < states->size(); port++)
+  {
+    Controller* controller = Pad::GetController(port);
+    GDBServer::LockstepPadState& state = (*states)[port];
+    if (!controller)
+    {
+      state = {};
+      continue;
+    }
+    state.buttons = controller->GetButtonStateBits() & 0xffffu;
+    state.analog = 0x80808080u;
+    if (controller->GetType() == ControllerType::DigitalController)
+      state.type = 1;
+    else if (controller->GetType() == ControllerType::AnalogController)
+    {
+      state.type = 2;
+      state.analog = controller->GetAnalogInputBytes().value_or(0x80808080u);
+    }
+    else
+    {
+      *error = "unsupported_controller";
+      return false;
+    }
+  }
+  return true;
+}
+
+static bool ApplyLockstepPads(const std::array<GDBServer::LockstepPadState, 2>& states, std::string* error)
+{
+  for (u32 port = 0; port < states.size(); port++)
+  {
+    Controller* controller = Pad::GetController(port);
+    const GDBServer::LockstepPadState& state = states[port];
+    if (!state.type)
+    {
+      if (controller)
+      {
+        *error = "controller_presence_mismatch";
+        return false;
+      }
+      continue;
+    }
+    if (!controller || (state.type == 1 && controller->GetType() != ControllerType::DigitalController) ||
+        (state.type == 2 && controller->GetType() != ControllerType::AnalogController))
+    {
+      *error = "controller_type_mismatch";
+      return false;
+    }
+    if (state.type == 2)
+    {
+      if (!static_cast<AnalogController*>(controller)->SetTraceInput(static_cast<u16>(state.buttons), state.analog))
+      {
+        *error = "controller_busy";
+        return false;
+      }
+      continue;
+    }
+    for (u32 bit = 0; bit < 16; bit++)
+      controller->SetBindState(bit, (state.buttons & (1u << bit)) ? 1.0f : 0.0f);
+  }
+  return true;
+}
+
+void GDBServer::OnLockstepFrameDone()
+{
+  if (!s_locals.lockstep_frame_active || s_locals.lockstep_event_pending)
+    return;
+  const u32 frame = s_locals.lockstep_frame;
+  bool valid = true;
+  s_locals.lockstep_frame_error.clear();
+  if (s_locals.lockstep_record_active)
+  {
+    LockstepRecordFrame recorded;
+    recorded.frame = frame;
+    valid = CaptureLockstepPads(&recorded.pads, &s_locals.lockstep_frame_error);
+    if (!valid)
+    {
+      s_locals.lockstep_frame_active = false;
+      s_locals.lockstep_record_active = false;
+      System::PauseSystem(true);
+      return;
+    }
+    s_locals.lockstep_record_frames.push_back(recorded);
+    s_locals.lockstep_frame++;
+    if (s_locals.lockstep_record_limit && s_locals.lockstep_frame >= s_locals.lockstep_record_limit)
+    {
+      s_locals.lockstep_frame_active = false;
+      s_locals.lockstep_record_active = false;
+      System::PauseSystem(true);
+    }
+    return;
+  }
+  if (s_locals.lockstep_replay_active)
+  {
+    if (!s_locals.lockstep_input_queued)
+    {
+      s_locals.lockstep_frame_error = "missing_frame_input";
+      valid = false;
+    }
+    else if (s_locals.lockstep_queued_frame != frame)
+    {
+      s_locals.lockstep_frame_error = "frame_input_mismatch";
+      valid = false;
+    }
+    else
+    {
+      valid = ApplyLockstepPads(s_locals.lockstep_queued_pad_state, &s_locals.lockstep_frame_error);
+      s_locals.lockstep_input_queued = false;
+    }
+  }
+  if (valid)
+    valid = CaptureLockstepPads(&s_locals.lockstep_pad_state, &s_locals.lockstep_frame_error);
+  s_locals.lockstep_event_pending = s_locals.lockstep_tracker.FrameDone(
+    frame, !valid, &s_locals.lockstep_event);
+  if (valid)
+    s_locals.lockstep_frame++;
+  if (s_locals.lockstep_event_pending)
+  {
+    if (valid && s_locals.lockstep_prefix_guard && frame >= s_locals.lockstep_target_frame)
+      s_locals.lockstep_transition_pending = true;
+    System::PauseSystem(true);
+  }
+}
+
+void GDBServer::OnLockstepSpuEvent(u32 kind, u32 address, u32 value, u64 ticks)
+{
+  if (!s_locals.lockstep_replay_active || !s_locals.lockstep_frame_active ||
+      !s_locals.lockstep_peer.IsAttached())
+    return;
+  s_locals.lockstep_peer.PublishSpuEvent(
+    static_cast<XportLockstep::SpuEventKind>(kind), address, value, ticks);
+}
+
+static std::string_view TakeLockstepField(std::string_view* data)
+{
+  const size_t separator = data->find(':');
+  if (separator == std::string_view::npos)
+  {
+    const std::string_view field = *data;
+    *data = {};
+    return field;
+  }
+  const std::string_view field = data->substr(0, separator);
+  data->remove_prefix(separator + 1);
+  return field;
+}
+
+static bool IsLockstepIdentity(std::string_view value, size_t length)
+{
+  if (value.size() != length)
+    return false;
+  for (const char character : value)
+  {
+    if (!((character >= '0' && character <= '9') || (character >= 'a' && character <= 'f')))
+      return false;
+  }
+  return true;
+}
+
+static std::string_view LockstepErrorName(XportLockstep::Error error)
+{
+  switch (error)
+  {
+    case XportLockstep::Error::None: return "ok";
+    case XportLockstep::Error::PlatformUnsupported: return "platform_unsupported";
+    case XportLockstep::Error::InvalidIdentity: return "invalid_identity";
+    case XportLockstep::Error::AlreadyAttached: return "already_attached";
+    case XportLockstep::Error::OpenFailed: return "open_failed";
+    case XportLockstep::Error::SizeMismatch: return "size_mismatch";
+    case XportLockstep::Error::MapFailed: return "map_failed";
+    case XportLockstep::Error::NotAttached: return "not_attached";
+    case XportLockstep::Error::InvalidStackRanges: return "invalid_stack_ranges";
+    case XportLockstep::Error::UnknownStackRanges: return "unknown_stack_ranges";
+    case XportLockstep::Error::AlreadySeeded: return "already_seeded";
+    case XportLockstep::Error::Unseeded: return "unseeded";
+    case XportLockstep::Error::InvalidDeferredState: return "invalid_deferred_state";
+    default: return "unknown";
+  }
+}
+
+static bool SendLockstepError(GDBServer::ClientSocket* client, std::string_view request, std::string_view code)
+{
+  client->SendReplyWithAck(TinyString::from_format("ERROR:{}:{}", request, code));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepAttach(ClientSocket* client, std::string_view data)
+{
+  const std::string_view run_id = TakeLockstepField(&data);
+  const std::string_view dram_name = TakeLockstepField(&data);
+  const std::string_view scratchpad_name = TakeLockstepField(&data);
+  const std::string_view deferred_name = TakeLockstepField(&data);
+  if (!data.empty() || run_id.empty() || dram_name.empty() || scratchpad_name.empty() ||
+      deferred_name.empty())
+    return SendLockstepError(client, run_id, "malformed_attach");
+  const XportLockstep::Error error =
+    s_locals.lockstep_peer.Attach(run_id, dram_name, scratchpad_name, deferred_name);
+  if (error != XportLockstep::Error::None)
+    return SendLockstepError(client, run_id, LockstepErrorName(error));
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", run_id));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepExceptions(ClientSocket* client, std::string_view data)
+{
+  const std::string_view identity = TakeLockstepField(&data);
+  if (!IsLockstepIdentity(identity, 64) || data.empty())
+    return SendLockstepError(client, identity, "invalid_stack_ranges");
+  std::vector<XportLockstep::Range> ranges;
+  while (!data.empty())
+  {
+    const size_t end = data.find(';');
+    const std::string_view encoded = data.substr(0, end);
+    const size_t first_comma = encoded.find(',');
+    const size_t second_comma = first_comma == std::string_view::npos ? std::string_view::npos :
+      encoded.find(',', first_comma + 1);
+    const std::string_view region_name = encoded.substr(0, first_comma);
+    const auto offset = second_comma == std::string_view::npos ? std::nullopt :
+      StringUtil::FromChars<u32>(encoded.substr(first_comma + 1, second_comma - first_comma - 1), 16);
+    const auto size = second_comma == std::string_view::npos ? std::nullopt :
+      StringUtil::FromChars<u32>(encoded.substr(second_comma + 1), 16);
+    XportLockstep::Range::Region region;
+    if (region_name == "dram")
+      region = XportLockstep::Range::Region::Dram;
+    else if (region_name == "scratchpad")
+      region = XportLockstep::Range::Region::Scratchpad;
+    else
+      return SendLockstepError(client, identity, "invalid_stack_ranges");
+    if (!offset.has_value() || !size.has_value())
+      return SendLockstepError(client, identity, "invalid_stack_ranges");
+    ranges.push_back({region, *offset, *size});
+    if (end == std::string_view::npos)
+      data = {};
+    else
+      data.remove_prefix(end + 1);
+  }
+  const XportLockstep::Error error = s_locals.lockstep_peer.SetStackRanges(identity, ranges);
+  if (error != XportLockstep::Error::None)
+    return SendLockstepError(client, identity, LockstepErrorName(error));
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", identity));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepMode(ClientSocket* client, std::string_view data)
+{
+  const std::string_view mode = TakeLockstepField(&data);
+  const auto target = StringUtil::FromChars<u32>(data, 16);
+  if (!s_locals.lockstep_peer.IsAttached() || !s_locals.lockstep_replay_active ||
+      s_locals.lockstep_boundary_active || !target.has_value() ||
+      (mode != "DETAILED" && mode != "PREFIX_GUARD") ||
+      (mode == "DETAILED" && *target != 0) || (mode == "PREFIX_GUARD" && *target == 0))
+    return SendLockstepError(client, "mode", "invalid_mode");
+  s_locals.lockstep_prefix_guard = mode == "PREFIX_GUARD";
+  System::SetFastForwardEnabled(true);
+  s_locals.lockstep_target_frame = *target;
+  s_locals.lockstep_epoch = 0;
+  s_locals.lockstep_mode_configured = true;
+  s_locals.lockstep_transition_pending = false;
+  client->SendReplyWithAck(TinyString::from_format("OK:{}:{:x}", mode, *target));
+  return true;
+}
+
+static bool IsLockstepRequest(std::string_view value)
+{
+  if (value.empty() || value.size() > 64)
+    return false;
+  for (const char character : value)
+  {
+    if (!((character >= '0' && character <= '9') || (character >= 'a' && character <= 'z') ||
+          (character >= 'A' && character <= 'Z') || character == '_' || character == '-'))
+      return false;
+  }
+  return true;
+}
+
+static bool SendLockstepDifference(GDBServer::ClientSocket* client, std::string_view request,
+                                   const XportLockstep::Difference& difference, u32 offset, u32 length)
+{
+  const std::string_view region = difference.region == XportLockstep::Difference::Region::Dram ?
+                                    "dram" : "scratchpad";
+  const u32 relative = offset - difference.offset;
+  const std::string original = StringUtil::EncodeHex(difference.original.data() + relative, length);
+  const std::string candidate = StringUtil::EncodeHex(difference.candidate.data() + relative, length);
+  client->SendReplyWithAck(TinyString::from_format("DIFF:{}:{}:{:x}:{:x}:{}:{}", request, region, offset,
+                                                   length, original, candidate));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepCompare(ClientSocket* client, std::string_view data)
+{
+  const std::string_view request = TakeLockstepField(&data);
+  const std::string_view stack_identity = TakeLockstepField(&data);
+  if (!IsLockstepRequest(request) || !IsLockstepIdentity(stack_identity, 64) || !data.empty())
+    return SendLockstepError(client, request, "malformed_compare");
+  if (!System::IsPaused() || System::IsExecuting())
+    return SendLockstepError(client, request, "not_stopped");
+  XportLockstep::Difference difference;
+  u32 deferred_generation = 0;
+  const XportLockstep::Error error = s_locals.lockstep_peer.Compare(
+    stack_identity, g_bus.ram, CPU::g_state.scratchpad.data(), &difference, &deferred_generation);
+  if (error != XportLockstep::Error::None)
+    return SendLockstepError(client, request, LockstepErrorName(error));
+  s_locals.lockstep_request = request;
+  s_locals.lockstep_difference = difference;
+  if (difference.region == XportLockstep::Difference::Region::None)
+  {
+    if (deferred_generation)
+      client->SendReplyWithAck(TinyString::from_format("DEFERRED:{}:{:x}", request, deferred_generation));
+    else
+      client->SendReplyWithAck(TinyString::from_format("OK:{}", request));
+    return true;
+  }
+  return SendLockstepDifference(client, request, difference, difference.offset, difference.length);
+}
+
+bool GDBServer::Cmd$qXportLockstepDiff(ClientSocket* client, std::string_view data)
+{
+  const std::string_view request = TakeLockstepField(&data);
+  const std::string_view region = TakeLockstepField(&data);
+  const std::string_view offset_text = TakeLockstepField(&data);
+  const std::string_view length_text = TakeLockstepField(&data);
+  const auto offset = StringUtil::FromChars<u32>(offset_text, 16);
+  const auto length = StringUtil::FromChars<u32>(length_text, 16);
+  const std::string_view expected_region =
+    s_locals.lockstep_difference.region == XportLockstep::Difference::Region::Dram ? "dram" : "scratchpad";
+  if (!data.empty() || request != s_locals.lockstep_request || region != expected_region ||
+      !offset.has_value() || !length.has_value() || !*length || *length > XportLockstep::MAX_DIFF_SIZE ||
+      *length > s_locals.lockstep_difference.length ||
+      *offset < s_locals.lockstep_difference.offset ||
+      *offset > s_locals.lockstep_difference.offset + s_locals.lockstep_difference.length - *length)
+    return SendLockstepError(client, request, "invalid_diff_range");
+  return SendLockstepDifference(client, request, s_locals.lockstep_difference, *offset, *length);
+}
+
+bool GDBServer::Cmd$qXportLockstepDetach(ClientSocket* client, std::string_view data)
+{
+  const XportLockstep::Error error = s_locals.lockstep_peer.Detach(data);
+  if (error != XportLockstep::Error::None)
+    return SendLockstepError(client, data, LockstepErrorName(error));
+  s_locals.lockstep_request.clear();
+  s_locals.lockstep_difference = {};
+  s_locals.lockstep_boundary_active = false;
+  s_locals.lockstep_frame_active = false;
+  s_locals.lockstep_replay_active = false;
+  s_locals.lockstep_record_active = false;
+  s_locals.lockstep_input_queued = false;
+  s_locals.lockstep_record_frames.clear();
+  s_locals.function_coverage.Reset();
+  s_locals.function_coverage_active = false;
+  s_locals.lockstep_record_identity.clear();
+  s_locals.lockstep_frame_error.clear();
+  s_locals.lockstep_checkpoint_state.clear();
+  s_locals.lockstep_checkpoint_candidate.clear();
+  s_locals.lockstep_checkpoint_size = 0;
+  s_locals.lockstep_frame = 0;
+  s_locals.lockstep_event_pending = false;
+  s_locals.lockstep_prefix_guard = false;
+  System::SetFastForwardEnabled(false);
+  s_locals.lockstep_mode_configured = false;
+  s_locals.lockstep_transition_pending = false;
+  s_locals.lockstep_target_frame = 0;
+  s_locals.lockstep_record_limit = 0;
+  s_locals.lockstep_epoch = 0;
+  CPU::UpdateDebugDispatcherFlag();
+  client->SendReplyWithAck(TinyString::from_format("OK:{}", data));
+  return true;
+}
+
+bool GDBServer::Cmd$qXportLockstepStart(ClientSocket* client, std::string_view data)
+{
+  if (!data.empty() || !s_locals.lockstep_peer.IsAttached() || !s_locals.lockstep_peer.IsSeeded() ||
+      !s_locals.lockstep_replay_active || !s_locals.lockstep_mode_configured)
+    return SendLockstepError(client, "start", "replay_not_ready");
+  s_locals.lockstep_tracker.Reset();
+  s_locals.lockstep_event = {};
+  s_locals.lockstep_event_pending = false;
+  s_locals.lockstep_frame = 0;
+  s_locals.lockstep_checkpoint_state.clear();
+  s_locals.lockstep_checkpoint_candidate.clear();
+  s_locals.lockstep_peer.ResetSpuTimeline();
+  s_locals.lockstep_checkpoint_size = 0;
+  s_locals.lockstep_boundary_active = true;
+  s_locals.lockstep_frame_active = true;
+  CPU::UpdateDebugDispatcherFlag();
+  client->SendReplyWithAck("OK:start");
+  return true;
+}
